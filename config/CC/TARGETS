local compiler_family = jst.get('FAMILY', jst.env('TOOLCHAIN_CONFIG', default={}), default='unknown');

{
  defaults: {
    type: @'//CC:defaults',
    arguments_config: ['ARCH', 'TARGET_ARCH', 'TOOLCHAIN_CONFIG'],
    base: [@'base//CC:defaults'],
    ADD_CFLAGS: ['-std=gnu17'],
    ADD_CXXFLAGS:
      ['-std=c++17', '-DHAVE_PTHREAD=1', '-DHAVE_ZLIB=1']
      + (if compiler_family == 'msvc' then
           [
             '/wd4065',
             '/wd4146',
             '/wd4244',
             '/wd4251',
             '/wd4267',
             '/wd4305',
             '/wd4307',
             '/wd4309',
             '/wd4334',
             '/wd4355',
             '/wd4506',
             '/wd4800',
             '/wd4996',
           ]
         else
           [
             '-Woverloaded-virtual',
             '-Wno-sign-compare',
             '-Wno-sign-conversion',
             '-Wno-unused-function',
             '-Wno-deprecated-declarations',
             '-Wno-nonnull',
           ]
           + (if compiler_family == 'gnu' then
                ['-Wno-attributes', '-Wno-deprecated-enum-enum-conversion']
              else if compiler_family == 'clang' then
                ['-Wno-atomic-alignment', '-Wno-return-stack-address'])),
  },
}
