local compiler_family = jst.get('FAMILY', jst.env('TOOLCHAIN_CONFIG', default={}), default='unknown');

{
  defaults: {
    type: @'//CC:defaults',
    arguments_config: ['TOOLCHAIN_CONFIG'],
    base: [@'base//CC:defaults'],
    ADD_LDFLAGS:
      if compiler_family != 'msvc' then
        ['-Wl,-z,noexecstack'],
  },
}
