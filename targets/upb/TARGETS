  // upb (https://github.com/protocolbuffers/protobuf/tree/main/upb): a
  // small, fast, C-based protobuf runtime, used by protoc's own Rust code
  // generator (compiler/rust/upb_helpers.cc) and by upb_generator's own
  // support code (both compiled directly into "libprotoc").
  upb: {
    type: @'rules//CC:library',
    name: ['upb'],
    'pure C': ['yes'],
    hdrs: [
      'upb_hdrs',
      @'./reflection/cmake:bootstrap_hdrs',
