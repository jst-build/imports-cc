  // "hdrs"/"srcs" field entries (including "@'...'" references) are always
  // re-staged under this library's own "stage" prefix; a "deps" edge is
  // not — it keeps the dependency's own independently-resolved position.
  // "generated_code_support.h" is a real upb file (needs the "upb/"
  // prefix), so it gets its own tiny library here rather than being
  // embedded directly wherever it's needed.
  generated_code_support_hdr: {
    type: @'rules//CC:library',
    'pure C': ['yes'],
    hdrs: ['generated_code_support.h'],
    stage: ['upb'],
    // "generated_code_support.h" itself further includes upb's own
    // base/message/mini_table/wire/mini_descriptor headers.
    deps: ['upb_wire_lib', 'upb_mini_descriptor_lib'],
  },

  upb_mini_descriptor_lib: {
    type: @'rules//CC:library',
    'pure C': ['yes'],
    name: ['upb_mini_descriptor_lib'],
