      'mini_descriptor/build_enum.c',
      'mini_descriptor/decode.c',
      'mini_descriptor/internal/base92.c',
      'mini_descriptor/internal/encode.c',
      'mini_descriptor/link.c',
      'wire/decode_fast/select.c',
    ],
    // "wire/eps_copy_input_stream.c" and "wire/reader.c" are also
    // independently compiled by "upb_wire_lib" (upstream's own
    // build_autogenerated.yaml lists them under both libraries' own
    // "srcs", harmless when only one ends up in a given link). Since
    // both libraries are folded as components into "upb_reflection_lib",
    // compiling them here too would produce a duplicate, colliding
    // object path; depend on "upb_wire_lib" for them instead.
    deps: [
      'upb_mini_table_lib',
      'upb_wire_lib',
      @'absl//:strings',
    ],
  },

