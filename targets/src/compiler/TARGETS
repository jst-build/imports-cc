{
  grpc_plugin_support: {
    type: @'rules//CC:library',
    name: ['grpc_plugin_support'],
    stage: ['src', 'compiler'],
    srcs: [
      'cpp_generator.cc',
      'csharp_generator.cc',
      'node_generator.cc',
      'objective_c_generator.cc',
      'php_generator.cc',
      'proto_parser_helper.cc',
      'python_generator.cc',
      'ruby_generator.cc',
    ],
    'private-hdrs': [
      'config.h',
      'config_protobuf.h',
      'cpp_generator.h',
      'cpp_generator_helpers.h',
      'cpp_plugin.h',
      'csharp_generator.h',
      'csharp_generator_helpers.h',
      'generator_helpers.h',
      'node_generator.h',
      'node_generator_helpers.h',
      'objective_c_generator.h',
      'objective_c_generator_helpers.h',
      'php_generator.h',
      'php_generator_helpers.h',
      'proto_parser_helper.h',
      'protobuf_plugin.h',
      'python_generator.h',
      'python_generator_helpers.h',
      'python_private_generator.h',
      'ruby_generator.h',
      'ruby_generator_helpers-inl.h',
      'ruby_generator_map-inl.h',
      'ruby_generator_string-inl.h',
      'schema_interface.h',
    ],
    // "config_protobuf.h" is genuinely public API (grpc_plugin_support's
    // own "public_headers" in build_autogenerated.yaml) under both
    // include/grpc++/ and include/grpcpp/; "gpr_public_headers" covers
    // the "port_platform.h" copies this code also needs, without pulling
    // in the rest of gpr/grpc as a real dependency. Referenced via "deps"
    // (not "hdrs") since this library's own "stage: ['src', 'compiler']"
    // would otherwise re-prefix these already-correctly-staged bundles.
    deps: [
      @'//include/grpc:gpr_public_headers_lib',
      @'//include/grpc++:grpc++_config_proto_headers',
      @'//include/grpcpp:grpcpp_config_proto_headers',
      @'protobuf//:libprotobuf',
      @'protobuf//:libprotoc',
      @'protobuf//:utf8_validity',
      @'zlib//:zlib',
      @'absl//:algorithm_container',
      @'absl//:base',
      @'absl//:config',
      @'absl//:core_headers',
      @'absl//:dynamic_annotations',
      @'absl//:no_destructor',
      @'absl//:prefetch',
      @'absl//:cleanup',
      @'absl//:btree',
      @'absl//:fixed_array',
      @'absl//:flat_hash_map',
      @'absl//:flat_hash_set',
      @'absl//:layout',
      @'absl//:any_invocable',
      @'absl//:function_ref',
      @'absl//:overload',
      @'absl//:hash',
      @'absl//:absl_check',
      @'absl//:absl_log',
      @'absl//:memory',
      @'absl//:type_traits',
      @'absl//:bits',
      @'absl//:status',
      @'absl//:statusor',
      @'absl//:charset',
      @'absl//:cord',
      @'absl//:strings_internal',
      @'absl//:str_format',
      @'absl//:string_view',
      @'absl//:strings',
      @'absl//:synchronization',
      @'absl//:time',
      @'absl//:optional',
      @'absl//:span',
      @'absl//:utility',
    ],
  },

  // Header collection: each "*_plugin.cc" binary below directly
  // "#include"s a handful of "grpc_plugin_support"'s own private headers
  // by their full repo-relative path (they're thin wrappers around its
  // generator logic), which "private-hdrs" alone doesn't expose to a
  // separate target. Never grpc_plugin_support's own object files —
  // "grpc_plugin_support" itself still compiles them.
  grpc_plugin_support_internal_hdrs: {
    type: @'rules//CC:library',
    stage: ['src', 'compiler'],
    hdrs: [
      'config.h',
      'config_protobuf.h',
      'cpp_generator.h',
      'cpp_generator_helpers.h',
      'cpp_plugin.h',
      'csharp_generator.h',
      'csharp_generator_helpers.h',
      'generator_helpers.h',
      'node_generator.h',
      'node_generator_helpers.h',
      'objective_c_generator.h',
      'objective_c_generator_helpers.h',
      'php_generator.h',
      'php_generator_helpers.h',
      'proto_parser_helper.h',
      'protobuf_plugin.h',
      'python_generator.h',
      'python_generator_helpers.h',
      'python_private_generator.h',
      'ruby_generator.h',
      'ruby_generator_helpers-inl.h',
      'ruby_generator_map-inl.h',
      'ruby_generator_string-inl.h',
      'schema_interface.h',
    ],
  },

  grpc_cpp_plugin: {
    type: @'rules//CC:binary',
    name: ['grpc_cpp_plugin'],
    srcs: ['cpp_plugin.cc'],
    'private-deps': ['grpc_plugin_support', 'grpc_plugin_support_internal_hdrs'],
    'private-ldflags': [
      '-pthread',
      '-Wl,--whole-archive,-lpthread,--no-whole-archive',
    ],
  },

  grpc_csharp_plugin: {
    type: @'rules//CC:binary',
    name: ['grpc_csharp_plugin'],
    srcs: ['csharp_plugin.cc'],
    'private-deps': ['grpc_plugin_support', 'grpc_plugin_support_internal_hdrs'],
    'private-ldflags': [
      '-pthread',
      '-Wl,--whole-archive,-lpthread,--no-whole-archive',
    ],
  },

  grpc_node_plugin: {
    type: @'rules//CC:binary',
    name: ['grpc_node_plugin'],
    srcs: ['node_plugin.cc'],
    'private-deps': ['grpc_plugin_support', 'grpc_plugin_support_internal_hdrs'],
    'private-ldflags': [
      '-pthread',
      '-Wl,--whole-archive,-lpthread,--no-whole-archive',
    ],
  },

  grpc_objective_c_plugin: {
    type: @'rules//CC:binary',
    name: ['grpc_objective_c_plugin'],
    srcs: ['objective_c_plugin.cc'],
    'private-deps': ['grpc_plugin_support', 'grpc_plugin_support_internal_hdrs'],
    'private-ldflags': [
      '-pthread',
      '-Wl,--whole-archive,-lpthread,--no-whole-archive',
    ],
  },

  grpc_php_plugin: {
    type: @'rules//CC:binary',
    name: ['grpc_php_plugin'],
    srcs: ['php_plugin.cc'],
    'private-deps': ['grpc_plugin_support', 'grpc_plugin_support_internal_hdrs'],
    'private-ldflags': [
      '-pthread',
      '-Wl,--whole-archive,-lpthread,--no-whole-archive',
    ],
  },

  grpc_python_plugin: {
    type: @'rules//CC:binary',
    name: ['grpc_python_plugin'],
    srcs: ['python_plugin.cc'],
    'private-deps': ['grpc_plugin_support', 'grpc_plugin_support_internal_hdrs'],
    'private-ldflags': [
      '-pthread',
      '-Wl,--whole-archive,-lpthread,--no-whole-archive',
    ],
  },

  grpc_ruby_plugin: {
    type: @'rules//CC:binary',
    name: ['grpc_ruby_plugin'],
    srcs: ['ruby_plugin.cc'],
    'private-deps': ['grpc_plugin_support', 'grpc_plugin_support_internal_hdrs'],
    'private-ldflags': [
      '-pthread',
      '-Wl,--whole-archive,-lpthread,--no-whole-archive',
    ],
  },
}
