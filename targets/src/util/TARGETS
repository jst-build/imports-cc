{
  // Top-level "src/util/*.h" via jst.glob (non-recursive - matches this
  // module's own directory only), mirroring upstream's own real
  // "file(GLOB UTIL_SRC *.c *.h ...)" in src/util/CMakeLists.txt. This is
  // deliberately not a hand-maintained list: it already covers real
  // additions between versions (errors.h, hashmap.h, hashmap_str.h,
  // ctype_compat.h, process.h, strlist.h) without needing an update.
  util_private_headers: {
    type: @'rules//data:staged',
    arguments_config: ['USE_SHA1', 'USE_SHA256'],
    srcs: [
      jst.glob('*.h'),
      'allocators/failalloc.h',
      'allocators/stdalloc.h',
      'allocators/win32_leakcheck.h',
      'allocators/debugalloc.h',
      'hash/builtin.h',
      'hash/collisiondetect.h',
      'hash/common_crypto.h',
      'hash/mbedtls.h',
      'hash/openssl.h',
      'hash/sha.h',
      'hash/win32.h',
      'hash/sha1dc/sha1.h',
      'hash/sha1dc/ubc_check.h',
      'hash/rfc6234/sha.h',
      'unix/posix.h',
      'unix/pthread.h',
      'win32/dir.h',
      'win32/error.h',
      'win32/mingw-compat.h',
      'win32/msvc-compat.h',
      'win32/path_w32.h',
      'win32/posix.h',
      'win32/precompiled.h',
      'win32/reparse.h',
      'win32/thread.h',
      'win32/utf-conv.h',
      'win32/version.h',
      'win32/w32_buffer.h',
      'win32/w32_common.h',
      'win32/w32_leakcheck.h',
      'win32/w32_util.h',
      'win32/win32-compat.h',
      @'//include:git2_public_headers',
      'git2_features.h',
      @'//deps/xdiff:hdrs',
    ],
    deps:
      // Depending on the build options specified for "USE_SHA{1,256}", the
      // macros "GIT_SHA{1,256}_{OPENSSL,MBEDTLS}" are being defined (see
      // 'git2_features.h' below). This causes "./hash/sha.h" to include the
      // public headers of the backend (OpenSSL/mbedTLS). Therefore, add those
      // headers to the private header tree as well. This works because C/C++
      // libraries provide only public headers on the "runfiles stage", which is
      // the only stage consumed by this rule via "deps".
      (if jst.env('USE_SHA1') == 'OpenSSL' || jst.env('USE_SHA256') == 'OpenSSL' then
         [@'ssl//:crypto'])
      + (if jst.env('USE_SHA1') == 'mbedTLS' || jst.env('USE_SHA256') == 'mbedTLS' then
           [@'mbedtls//:crypto']),
  },

  util_os_unix: {
    type: @'rules//CC:library',
    arguments_config: ['OS', 'USE_THREADS', 'USE_ICONV'],
    name: ['util_os_unix'],
    'pure C': ['yes'],
    srcs: [
      'unix/map.c',
      'unix/process.c',
      'unix/realpath.c',
    ],
    'private-hdrs': ['util_private_headers'],
    'private-ldflags':
      (if jst.env('USE_THREADS') then
         [
           '-pthread',
           '-Wl,--whole-archive,-lpthread,--no-whole-archive',
         ])
      + (if jst.env('OS') == 'solaris' || jst.env('OS') == 'sunos' then
           [
             '-lsocket',
             '-lnsl',
           ]
         else if jst.env('OS') == 'haiku' then
           ['-lnetwork'])
      // Darwin is the only OS where "USE_ICONV" is meaningful (glibc's iconv
      // needs no separate link flag), so never emit a "-liconv" flag on a Linux
      // build that has no such library.
      + (if jst.env('USE_ICONV') && jst.env('OS') == 'darwin' then
           ['-liconv']),
  },

  util_os_win32: {
    type: @'rules//CC:library',
    name: ['util_os_win32'],
    'pure C': ['yes'],
    srcs: [
      'win32/dir.c',
      'win32/error.c',
      'win32/map.c',
      'win32/path_w32.c',
      'win32/posix_w32.c',
      'win32/precompiled.c',
      'win32/process.c',
      'win32/thread.c',
      'win32/utf-conv.c',
      'win32/w32_buffer.c',
      'win32/w32_leakcheck.c',
      'win32/w32_util.c',
    ],
    'private-hdrs': ['util_private_headers'],
    'private-ldflags': ['-lws2_32'],
  },

  util_hash_collision_detection: {
    type: @'rules//CC:library',
    name: ['util_hash_collision_detection'],
    'pure C': ['yes'],
    'private-defines': [
      'SHA1DC_NO_STANDARD_INCLUDES=1',
      'SHA1DC_CUSTOM_INCLUDE_SHA1_C="git2_util.h"',
      'SHA1DC_CUSTOM_INCLUDE_UBC_CHECK_C="git2_util.h"',
    ],
    srcs: [
      'hash/collisiondetect.c',
      'hash/sha1dc/sha1.c',
      'hash/sha1dc/ubc_check.c',
    ],
    'private-hdrs': ['util_private_headers'],
  },

  util_hash_openssl: {
    type: @'rules//CC:library',
    name: ['util_hash_openssl'],
    'pure C': ['yes'],
    srcs: ['hash/openssl.c'],
    'private-hdrs': ['util_private_headers'],
    deps: [@'ssl//:crypto'],
  },

  // No dependency to link, unlike for mbedTLS and "OpenSSL-Dynamic", the
  // "CC_SHA1"/"CC_SHA256" live in libSystem, which Apple platforms link
  // implicitly, so only the SDK's own "<CommonCrypto/CommonDigest.h>" is
  // needed.
  util_hash_common_crypto: {
    type: @'rules//CC:library',
    name: ['util_hash_common_crypto'],
    'pure C': ['yes'],
    srcs: ['hash/common_crypto.c'],
    'private-hdrs': ['util_private_headers'],
  },

  util_hash_mbedtls: {
    type: @'rules//CC:library',
    name: ['util_hash_mbedtls'],
    'pure C': ['yes'],
    srcs: ['hash/mbedtls.c'],
    'private-hdrs': ['util_private_headers'],
    deps: [@'mbedtls//:crypto'],
  },

  util_hash_win32: {
    type: @'rules//CC:library',
    name: ['util_hash_win32'],
    'pure C': ['yes'],
    srcs: ['hash/win32.c'],
    'private-hdrs': ['util_private_headers'],
  },

  util_hash_builtin: {
    type: @'rules//CC:library',
    name: ['util_hash_builtin'],
    'pure C': ['yes'],
    srcs: [
      'hash/builtin.c',
      'hash/rfc6234/sha224-256.c',
    ],
    'private-hdrs': ['util_private_headers'],
  },

  util_os: {
    type: @'rules//CC:library',
    name: ['utils_os'],
    arguments_config: ['OS'],
    components:
      if jst.env('OS') == 'windows' then
        ['util_os_win32']
      else
        ['util_os_unix'],
  },

  util_sha1: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SHA1'],
    name: ['utils_sha1'],
    components:
      if jst.env('USE_SHA1') == 'CollisionDetection' then
        ['util_hash_collision_detection']
      else if jst.env('USE_SHA1') == 'OpenSSL' then
        ['util_hash_openssl']
      else if jst.env('USE_SHA1') == 'CommonCrypto' then
        ['util_hash_common_crypto']
      else if jst.env('USE_SHA1') == 'mbedTLS' then
        ['util_hash_mbedtls']
      else if jst.env('USE_SHA1') == 'Win32' then
        ['util_hash_win32']
      else
        jst.fail('Asked for unknown SHA1 backend in `USE_SHA1`'),
  },

  util_sha256: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SHA256'],
    name: ['utils_sha256'],
    components:
      if jst.env('USE_SHA256') == 'Builtin' then
        ['util_hash_builtin']
      else if jst.env('USE_SHA256') == 'OpenSSL' then
        ['util_hash_openssl']
      else if jst.env('USE_SHA256') == 'CommonCrypto' then
        ['util_hash_common_crypto']
      else if jst.env('USE_SHA256') == 'mbedTLS' then
        ['util_hash_mbedtls']
      else if jst.env('USE_SHA256') == 'Win32' then
        ['util_hash_win32']
      else
        jst.fail('Asked for unknown SHA256 backend in `USE_SHA256`'),
  },

  // "REGEX_BACKEND=='builtin'" (and the "null" default) compile the real
  // bundled PCRE2 (upstream's own "builtin" choice is PCRE2, not a
  // separate "pcre2" backend - see cmake/SelectRegex.cmake). "pcre2"/
  // "pcre" ask for a *system* library instead (both dangling externs in
  // this repo). "regcomp"/"regcomp_l" need no extern at all (glibc).
  util_regex: {
    type: @'rules//CC:library',
    arguments_config: ['REGEX_BACKEND'],
    name: ['util_regex'],
    components:
      if jst.env('REGEX_BACKEND') == 'builtin' then
        [@'//deps/pcre2:git2_pcre2']
      else if jst.env('REGEX_BACKEND') == null then
        [@'//deps/pcre2:git2_pcre2'],
    deps:
      if jst.env('REGEX_BACKEND') == 'pcre2' then
        [@'pcre2//:pcre2']
      else if jst.env('REGEX_BACKEND') == 'pcre' then
        [@'pcre//:pcre'],
  },

  util_compress: {
    type: @'rules//CC:library',
    arguments_config: ['USE_BUNDLED_ZLIB'],
    name: ['util_compress'],
    components:
      if jst.env('USE_BUNDLED_ZLIB') == 'Chromium' then
        jst.fail('USE_BUNDLED_ZLIB="Chromium" (deps/chromium-zlib) is not supported.')
      else if jst.env('USE_BUNDLED_ZLIB') then
        [@'//deps/zlib:git2_zlib'],
    deps:
      if !jst.env('USE_BUNDLED_ZLIB') then
        [@'zlib//:zlib'],
  },

  // "USE_SSH=='exec'" needs no extern at all (shells out to the system
  // "ssh" binary at runtime, via src/libgit2/transports/ssh_exec.c).
  util_ssh: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SSH'],
    name: ['util_ssh'],
    deps:
      if jst.env('USE_SSH') == 'libssh2' then
        [@'libssh2//:libssh2'],
  },

  util_ntlmclient: {
    type: @'rules//CC:library',
    arguments_config: ['USE_NTLMCLIENT'],
    name: ['util_ntlmclient'],
    components:
      if jst.env('USE_NTLMCLIENT') then
        [@'//deps/ntlmclient:git2_ntlmclient'],
  },

  // Real upstream values (cmake/SelectHTTPParser.cmake): "http-parser"/
  // "system" (the old http-parser library, system-only), "llhttp"
  // (system llhttp), ""/"builtin" (bundled llhttp, the default).
  util_http_parser: {
    type: @'rules//CC:library',
    arguments_config: ['USE_HTTP_PARSER'],
    name: ['util_http_parser'],
    components:
      if jst.env('USE_HTTP_PARSER') != 'http-parser' && jst.env('USE_HTTP_PARSER') != 'system' && jst.env('USE_HTTP_PARSER') != 'llhttp' then
        [@'//deps/llhttp:git2_llhttp'],
    deps:
      if jst.env('USE_HTTP_PARSER') == 'http-parser' || jst.env('USE_HTTP_PARSER') == 'system' then
        [@'http_parser//:http_parser']
      else if jst.env('USE_HTTP_PARSER') == 'llhttp' then
        [@'llhttp//:llhttp'],
  },

  util_gssapi: {
    type: @'rules//CC:library',
    name: ['util_gssapi'],
    arguments_config: ['USE_GSSAPI'],
    deps:
      if jst.env('USE_GSSAPI') then
        [@'gssapi//:gssapi'],
  },

  util_https: {
    type: @'rules//CC:library',
    name: ['util_https'],
    arguments_config: ['USE_HTTPS'],
    'private-ldflags':
      if jst.env('USE_HTTPS') == 'WinHTTP' then
        ['-lwinhttp']
      else if jst.env('USE_HTTPS') == 'SecureTransport' then
        [
          '-framework',
          'CoreFoundation',
          '-framework',
          'Security',
        ],
    deps:
      if jst.env('USE_HTTPS') == 'OpenSSL' then
        [@'ssl//:ssl']
      else if jst.env('USE_HTTPS') == 'mbedTLS' then
        [@'mbedtls//:ssl']
      else if jst.env('USE_HTTPS') == 'SecureTransport' then
        [@'secure_transport//:ssl'],
  },

  util_sources: {
    type: @'rules//data:staged',
    srcs: [
      jst.glob('*.c'),
      'allocators/failalloc.c',
      'allocators/stdalloc.c',
      'allocators/win32_leakcheck.c',
      'allocators/debugalloc.c',
      @'//deps/xdiff:srcs',
    ],
  },

  'git2_features.h': {
    type: 'configure',
    arguments_config: [
      'OS',
      'ARCH',
      'TARGET_ARCH',
      'DEBUG_POOL',
      'DEBUG_STRICT_ALLOC',
      'DEBUG_STRICT_OPEN',
      'USE_THREADS',
      'REGEX_BACKEND',
      'USE_ICONV',
      'USE_NSEC',
      'USE_SSH',
      'USE_NTLMCLIENT',
      'USE_GSSAPI',
      'USE_SHA1',
      'USE_SHA256',
      'USE_HTTPS',
      'USE_HTTP_PARSER',
      'USE_BUNDLED_ZLIB',
    ],
    target: 'feature_header',
    config:
      local target_arch = jst.env('TARGET_ARCH', default=jst.env('ARCH'));
      local is_bsd = jst.env('OS') == 'darwin' || jst.env('OS') == 'bsd';
      local is_32bit = target_arch == 'x86' || target_arch == 'arm';
      local use_ssh = jst.env('USE_SSH');
      {
        defines1:
          [
            ['GIT_DEBUG_POOL', jst.env('DEBUG_POOL')],
            ['GIT_DEBUG_STRICT_ALLOC', jst.env('DEBUG_STRICT_ALLOC')],
            ['GIT_DEBUG_STRICT_OPEN', jst.env('DEBUG_STRICT_OPEN')],
            ['GIT_THREADS', jst.env('USE_THREADS')],
            if (is_32bit) then
              ['GIT_ARCH_32', 1]
            else
              ['GIT_ARCH_64', 1],
            ['GIT_USE_ICONV', jst.env('USE_ICONV')],
            // Real upstream ties this to whether libssh2 exposes
            // "libssh2_userauth_publickey_frommemory" - always true for
            // the libssh2 version this branch links against.
            ['GIT_SSH', use_ssh != false && use_ssh != null],
            ['GIT_SSH_EXEC', use_ssh == 'exec'],
            ['GIT_SSH_LIBSSH2', use_ssh == 'libssh2'],
            ['GIT_SSH_LIBSSH2_MEMORY_CREDENTIALS', use_ssh == 'libssh2'],
            ['GIT_NTLM', jst.env('USE_NTLMCLIENT')],
            ['GIT_IO_WSAPOLL', jst.env('OS') == 'windows'],
          ]
          + (if (jst.env('USE_NSEC')) then
               [
                 ['GIT_USE_NSEC', 1],
                 ['GIT_USE_FUTIMENS', 1],
                 ['GIT_USE_STAT_MTIME_NSEC', 1],
                 if (is_bsd) then
                   ['GIT_USE_STAT_MTIMESPEC', 1]
                 else
                   ['GIT_USE_STAT_MTIM', 1],
               ])
          + [
            if jst.env('REGEX_BACKEND') == 'regcomp_l' then
              ['GIT_REGEX_REGCOMP_L', 1]
            else if jst.env('REGEX_BACKEND') == 'regcomp' then
              ['GIT_REGEX_REGCOMP', 1]
            else if jst.env('REGEX_BACKEND') == 'pcre' then
              ['GIT_REGEX_PCRE', 1]
            else if jst.env('REGEX_BACKEND') == 'pcre2' then
              ['GIT_REGEX_PCRE2', 1]
            else if jst.env('REGEX_BACKEND') == 'builtin' then
              ['GIT_REGEX_BUILTIN', 1]
            else if jst.env('REGEX_BACKEND') == null then
              ['GIT_REGEX_BUILTIN', 1]
            else
              jst.fail('The REGEX_BACKEND option provided is not supported'),
          ]
          + (if jst.env('USE_GSSAPI') == 'GSS.framework' then
               [['GIT_GSSFRAMEWORK', 1]]
             else if jst.env('USE_GSSAPI') == 'gssapi' then
               [['GIT_GSSAPI', 1]]
             else if jst.env('USE_GSSAPI') == false then
               []
             else
               jst.fail('Backend asked for in USE_GSSAPI is not supported'))
          + (if jst.env('USE_HTTPS') then
               [
                 ['GIT_HTTPS', 1],
                 if jst.env('USE_HTTPS') == 'SecureTransport' then
                   ['GIT_SECURE_TRANSPORT', 1]
                 else if jst.env('USE_HTTPS') == 'OpenSSL' then
                   ['GIT_OPENSSL', 1]
                 else if jst.env('USE_HTTPS') == 'mbedTLS' then
                   ['GIT_MBEDTLS', 1]
                 else if jst.env('USE_HTTPS') == 'WinHTTP' then
                   ['GIT_WINHTTP', 1]
                 else
                   jst.fail('Backend asked for in USE_HTTPS is not supported'),
               ])
          + (if jst.env('USE_SHA1') == 'CollisionDetection' then
               [['GIT_SHA1_COLLISIONDETECT', 1]]
             else if jst.env('USE_SHA1') == 'Win32' then
               [['GIT_SHA1_WIN32', 1]]
             else if jst.env('USE_SHA1') == 'CommonCrypto' then
               [['GIT_SHA1_COMMON_CRYPTO', 1]]
             else if jst.env('USE_SHA1') == 'OpenSSL' then
               [['GIT_SHA1_OPENSSL', 1]]
             else if jst.env('USE_SHA1') == 'mbedTLS' then
               [['GIT_SHA1_MBEDTLS', 1]])
          + (if jst.env('USE_SHA256') == 'Builtin' then
               [['GIT_SHA256_BUILTIN', 1]]
             else if jst.env('USE_SHA256') == 'Win32' then
               [['GIT_SHA256_WIN32', 1]]
             else if jst.env('USE_SHA256') == 'CommonCrypto' then
               [['GIT_SHA256_COMMON_CRYPTO', 1]]
             else if jst.env('USE_SHA256') == 'OpenSSL' then
               [['GIT_SHA256_OPENSSL', 1]]
             else if jst.env('USE_SHA256') == 'mbedTLS' then
               [['GIT_SHA256_MBEDTLS', 1]])
          + (if jst.env('USE_HTTP_PARSER') == 'http-parser' || jst.env('USE_HTTP_PARSER') == 'system' then
               [['GIT_HTTPPARSER_HTTPPARSER', 1]]
             else if jst.env('USE_HTTP_PARSER') == 'llhttp' then
               [['GIT_HTTPPARSER_LLHTTP', 1]]
             else
               [['GIT_HTTPPARSER_BUILTIN', 1]])
          + (if jst.env('USE_BUNDLED_ZLIB') == 'Chromium' || jst.env('USE_BUNDLED_ZLIB') then
               [['GIT_COMPRESSION_BUILTIN', 1]]
             else
               [['GIT_COMPRESSION_ZLIB', 1]]),
        have_csymbol: [
          ['GIT_IO_POLL', ['poll', ['poll.h']]],
          ['GIT_IO_SELECT', ['select', ['sys/select.h']]],
        ],
      },
  },

  feature_header: {
    type: @'rules//CC/auto:config',
    name: ['git2_features.h'],
    guard: ['INCLUDE_features_h__'],
  },
}
