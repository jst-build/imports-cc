{
  util_private_headers: {
    type: @'rules//data:staged',
    srcs: [
      'alloc.h',
      'array.h',
      'assert_safe.h',
      'bitvec.h',
      'cc-compat.h',
      'date.h',
      'filebuf.h',
      'fs_path.h',
      'futils.h',
      'git2_util.h',
      'hash.h',
      'integer.h',
      'khash.h',
      'map.h',
      'net.h',
      'pool.h',
      'posix.h',
      'pqueue.h',
      'rand.h',
      'regexp.h',
      'runtime.h',
      'sortedcache.h',
      'staticstr.h',
      'str.h',
      'strmap.h',
      'strnlen.h',
      'thread.h',
      'utf8.h',
      'util.h',
      'varint.h',
      'vector.h',
      'wildmatch.h',
      'zstream.h',
      'allocators/failalloc.h',
      'allocators/stdalloc.h',
      'allocators/win32_leakcheck.h',
      'hash/builtin.h',
      'hash/collisiondetect.h',
      'hash/common_crypto.h',
      'hash/mbedtls.h',
      'hash/openssl.h',
      'hash/sha.h',
      'hash/win32.h',
      'hash/sha1dc/sha1.h',
      'hash/sha1dc/ubc_check.h',
      'hash/rfc6234/sha.h',
      'unix/posix.h',
      'unix/pthread.h',
      'win32/dir.h',
      'win32/error.h',
      'win32/mingw-compat.h',
      'win32/msvc-compat.h',
      'win32/path_w32.h',
      'win32/posix.h',
      'win32/precompiled.h',
      'win32/reparse.h',
      'win32/thread.h',
      'win32/utf-conv.h',
      'win32/version.h',
      'win32/w32_buffer.h',
      'win32/w32_common.h',
      'win32/w32_leakcheck.h',
      'win32/w32_util.h',
      'win32/win32-compat.h',
      @'//include:git2_public_headers',
      'git2_features.h',
      @'//deps/xdiff:hdrs',
    ],
  },

  util_os_unix: {
    type: @'rules//CC:library',
    arguments_config: ['OS', 'USE_THREADS'],
    name: ['util_os_unix'],
    'pure C': ['yes'],
    srcs: [
      'unix/map.c',
      'unix/realpath.c',
    ],
    'private-hdrs': ['util_private_headers'],
    'private-ldflags':
      (if jst.env('USE_THREADS') then
         [
           '-pthread',
           '-Wl,--whole-archive,-lpthread,--no-whole-archive',
         ])
      + (if jst.env('OS') == 'solaris' || jst.env('OS') == 'sunos' then
           [
             '-lsocket',
             '-lnsl',
           ]
         else if jst.env('OS') == 'haiku' then
           ['-lnetwork']),
  },

  util_os_win32: {
    type: @'rules//CC:library',
    name: ['util_os_win32'],
    'pure C': ['yes'],
    srcs: [
      'win32/dir.c',
      'win32/error.c',
      'win32/map.c',
      'win32/path_w32.c',
      'win32/posix_w32.c',
      'win32/precompiled.c',
      'win32/thread.c',
      'win32/utf-conv.c',
      'win32/w32_buffer.c',
      'win32/w32_leakcheck.c',
      'win32/w32_util.c',
    ],
    'private-hdrs': ['util_private_headers'],
    'private-ldflags': ['-lws2_32'],
  },

  util_hash_collision_detection: {
    type: @'rules//CC:library',
    name: ['util_hash_collision_detection'],
    'pure C': ['yes'],
    'private-defines': [
      'SHA1DC_NO_STANDARD_INCLUDES=1',
      'SHA1DC_CUSTOM_INCLUDE_SHA1_C="git2_util.h"',
      'SHA1DC_CUSTOM_INCLUDE_UBC_CHECK_C="git2_util.h"',
    ],
    srcs: [
      'hash/collisiondetect.c',
      'hash/sha1dc/sha1.c',
      'hash/sha1dc/ubc_check.c',
    ],
    'private-hdrs': ['util_private_headers'],
  },

  util_hash_openssl: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SYSTEM_LIBS'],
    name: ['util_hash_openssl'],
    'pure C': ['yes'],
    srcs: ['hash/openssl.c'],
    'private-hdrs': ['util_private_headers'],
    'private-ldflags':
      if jst.env('USE_SYSTEM_LIBS') then
        ['-lssl'],
    deps:
      if !jst.env('USE_SYSTEM_LIBS') then
        [@'ssl//:crypto'],
  },

  util_hash_common_crypto: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SYSTEM_LIBS'],
    name: ['util_hash_common_crypto'],
    'pure C': ['yes'],
    srcs: ['hash/common_crypto.c'],
    'private-hdrs': ['util_private_headers'],
    'private-ldflags':
      if jst.env('USE_SYSTEM_LIBS') then
        ['-lcommon_crypto'],
    deps:
      if !jst.env('USE_SYSTEM_LIBS') then
        [@'common_crypto//:crypto'],
  },

  util_hash_mbedtls: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SYSTEM_LIBS'],
    name: ['util_hash_mbedtls'],
    'pure C': ['yes'],
    srcs: ['hash/mbedtls.c'],
    'private-hdrs': ['util_private_headers'],
    'private-ldflags':
      if jst.env('USE_SYSTEM_LIBS') then
        ['-lmbedtls'],
    deps:
      if !jst.env('USE_SYSTEM_LIBS') then
        [@'mbedtls//:crypto'],
  },

  util_hash_win32: {
    type: @'rules//CC:library',
    name: ['util_hash_win32'],
    'pure C': ['yes'],
    srcs: ['hash/win32.c'],
    'private-hdrs': ['util_private_headers'],
  },

  util_hash_builtin: {
    type: @'rules//CC:library',
    name: ['util_hash_builtin'],
    'pure C': ['yes'],
    srcs: [
      'hash/builtin.c',
      'hash/rfc6234/sha224-256.c',
    ],
    'private-hdrs': ['util_private_headers'],
  },

  util_os: {
    type: @'rules//CC:library',
    arguments_config: ['OS'],
    deps:
      if jst.env('OS') == 'windows' then
        ['util_os_win32']
      else
        ['util_os_unix'],
  },

  util_sha1: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SHA1'],
    deps:
      if jst.env('USE_SHA1') == 'CollisionDetection' then
        ['util_hash_collision_detection']
      else if jst.env('USE_SHA1') == 'OpenSSL' then
        ['util_hash_openssl']
      else if jst.env('USE_SHA1') == 'CommonCrypto' then
        ['util_hash_common_crypto']
      else if jst.env('USE_SHA1') == 'mbedTLS' then
        ['util_hash_mbedtls']
      else if jst.env('USE_SHA1') == 'Win32' then
        ['util_hash_win32']
      else if jst.env('USE_SHA1') == 'Generic' then
        ['util_hash_generic']
      else
        jst.fail('Asked for unknown SHA1 backend in `USE_SHA1`'),
  },

  util_sha256: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SHA256'],
    deps:
      if jst.env('USE_SHA256') == 'Builtin' then
        ['util_hash_builtin']
      else if jst.env('USE_SHA256') == 'OpenSSL' then
        ['util_hash_openssl']
      else if jst.env('USE_SHA256') == 'CommonCrypto' then
        ['util_hash_common_crypto']
      else if jst.env('USE_SHA256') == 'mbedTLS' then
        ['util_hash_mbedtls']
      else if jst.env('USE_SHA256') == 'Win32' then
        ['util_hash_win32']
      else
        jst.fail('Asked for unknown SHA256 backend in `USE_SHA256`'),
  },

  util_regex: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SYSTEM_LIBS', 'REGEX_BACKEND'],
    name: ['util_regex'],
    'private-ldflags':
      if jst.env('USE_SYSTEM_LIBS') then
        if jst.env('REGEX_BACKEND') == 'pcre2' then
          ['-lpcre2-8']
        else if jst.env('REGEX_BACKEND') == 'pcre' then
          ['-lpcre'],
    deps:
      if jst.env('USE_SYSTEM_LIBS') then
        (if jst.env('REGEX_BACKEND') == 'builtin' then
           [@'//deps/pcre:git2_pcre']
         else if jst.env('REGEX_BACKEND') == null then
           [@'//deps/pcre:git2_pcre'])
      else
        (if jst.env('REGEX_BACKEND') == 'pcre2' then
           [@'pcre2//:pcre2']
         else if jst.env('REGEX_BACKEND') == 'pcre' then
           [@'pcre//:pcre']
         else if jst.env('REGEX_BACKEND') == 'builtin' then
           [@'//deps/pcre:git2_pcre']
         else if jst.env('REGEX_BACKEND') == null then
           [@'//deps/pcre:git2_pcre']),
  },

  util_compress: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SYSTEM_LIBS', 'USE_BUNDLED_ZLIB'],
    name: ['util_compress'],
    'private-ldflags':
      if !jst.env('USE_BUNDLED_ZLIB') && jst.env('USE_SYSTEM_LIBS') then
        ['-lz'],
    deps:
      if jst.env('USE_BUNDLED_ZLIB') then
        jst.fail('bundled zlib from deps/zlib not supported yet.')
      else if !jst.env('USE_SYSTEM_LIBS') then
        [@'zlib//:zlib'],
  },

  util_ssh: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SYSTEM_LIBS', 'USE_SSH'],
    name: ['util_ssh'],
    'private-ldflags':
      if jst.env('USE_SSH') && jst.env('USE_SYSTEM_LIBS') then
        ['-lssh2'],
    deps:
      if jst.env('USE_SSH') && !jst.env('USE_SYSTEM_LIBS') then
        [@'ssh2//:ssh'],
  },

  util_http_parser: {
    type: @'rules//CC:library',
    arguments_config: ['USE_SYSTEM_LIBS', 'USE_HTTP_PARSER'],
    name: ['util_http_parser'],
    'private-ldflags':
      if jst.env('USE_HTTP_PARSER') == 'system' && jst.env('USE_SYSTEM_LIBS') then
        ['-lhttp_parser'],
    deps:
      if jst.env('USE_HTTP_PARSER') == 'system' then
        (if !jst.env('USE_SYSTEM_LIBS') then
           [@'http_parser//:http_parser'])
      else
        [@'//deps/http-parser:git2_http_parser'],
  },

  util_gssapi: {
    type: @'rules//CC:library',
    arguments_config: ['OS', 'USE_SYSTEM_LIBS', 'USE_GSSAPI'],
    name: ['util_gssapi'],
    'private-ldflags':
      if jst.env('USE_SYSTEM_LIBS') then
        if jst.env('USE_GSSAPI') == true then
          (if (jst.env('OS') == 'darwin') then
             ['-framework', 'GSS']
           else
             ['-lgssapi'])
        else if jst.env('USE_GSSAPI') == 'gssapi' then
          ['-lgssapi']
        else if jst.env('USE_GSSAPI') == 'GSS.framework' then
          ['-framework', 'GSS'],
    deps:
      if !jst.env('USE_SYSTEM_LIBS') && jst.env('USE_GSSAPI') then
        [@'gssapi//:gssapi'],
  },

  util_https: {
    type: @'rules//CC:library',
    arguments_config: ['OS', 'USE_SYSTEM_LIBS', 'USE_HTTPS'],
    name: ['util_https'],
    'private-ldflags':
      if jst.env('USE_HTTPS') == 'WinHTTP' then
        ['-lwinhttp']
      else if jst.env('USE_SYSTEM_LIBS') then
        if jst.env('USE_HTTPS') == 'OpenSSL' then
          ['-lssl']
        else if jst.env('USE_HTTPS') == 'mbedTLS' then
          ['-lmbedtls']
        else if jst.env('USE_HTTPS') == 'SecureTransport' then
          [
            '-framework',
            'CoreFoundation',
            '-framework',
            'Security',
          ],
    deps:
      if !jst.env('USE_SYSTEM_LIBS') then
        (if jst.env('USE_HTTPS') == 'OpenSSL' then
           [@'ssl//:ssl']
         else if jst.env('USE_HTTPS') == 'mbedTLS' then
           [@'mbedtls//:ssl']
         else if jst.env('USE_HTTPS') == 'SecureTransport' then
           [@'secure_transport//:ssl']),
  },

  util_sources: {
    type: @'rules//data:staged',
    srcs: [
      'alloc.c',
      'date.c',
      'filebuf.c',
      'fs_path.c',
      'futils.c',
      'hash.c',
      'net.c',
      'pool.c',
      'posix.c',
      'pqueue.c',
      'rand.c',
      'regexp.c',
      'runtime.c',
      'sortedcache.c',
      'str.c',
      'strmap.c',
      'thread.c',
      'tsort.c',
      'utf8.c',
      'util.c',
      'varint.c',
      'vector.c',
      'wildmatch.c',
      'zstream.c',
      'allocators/failalloc.c',
      'allocators/stdalloc.c',
      'allocators/win32_leakcheck.c',
      @'//deps/xdiff:srcs',
    ],
  },

  'git2_features.h': {
    type: 'configure',
    arguments_config: [
      'OS',
      'ARCH',
      'TARGET_ARCH',
      'DEBUG_POOL',
      'USE_THREADS',
      'REGEX_BACKEND',
      'USE_ICONV',
      'USE_NSEC',
      'USE_SSH',
      'USE_NTLMCLIENT',
      'USE_GSSAPI',
      'USE_SHA1',
      'USE_SHA256',
      'USE_HTTPS',
    ],
    target: 'feature_header',
    config:
      local target_arch = jst.env('TARGET_ARCH', default=jst.env('ARCH'));
      local is_bsd = jst.env('OS') == 'darwin' || jst.env('OS') == 'bsd';
      local is_32bit = target_arch == 'x86' || target_arch == 'arm';
      {
        defines1:
          [
            ['GIT_DEBUG_POOL', jst.env('DEBUG_POOL')],
            ['GIT_THREADS', jst.env('USE_THREADS')],
            if (is_32bit) then
              ['GIT_ARCH_32', 1]
            else
              ['GIT_ARCH_64', 1],
            ['GIT_USE_ICONV', jst.env('USE_ICONV')],
            ['GIT_SSH', jst.env('USE_SSH')],
            ['GIT_SSH_MEMORY_CREDENTIALS', jst.env('USE_SSH')],
            ['GIT_NTLM', jst.env('USE_NTLMCLIENT')],
            ['GIT_IO_WSAPOLL', jst.env('OS') == 'windows'],
          ]
          + (if (jst.env('USE_NSEC')) then
               [
                 ['GIT_USE_NSEC', 1],
                 ['GIT_USE_FUTIMENS', 1],
                 ['GIT_USE_STAT_MTIME_NSEC', 1],
                 if (is_bsd) then
                   ['GIT_USE_STAT_MTIMESPEC', 1]
                 else
                   ['GIT_USE_STAT_MTIM', 1],
               ])
          + [
            if jst.env('REGEX_BACKEND') == 'regcomp_l' then
              ['GIT_REGEX_REGCOMP_L', 1]
            else if jst.env('REGEX_BACKEND') == 'regcomp' then
              ['GIT_REGEX_REGCOMP', 1]
            else if jst.env('REGEX_BACKEND') == 'pcre' then
              ['GIT_REGEX_PCRE', 1]
            else if jst.env('REGEX_BACKEND') == 'pcre2' then
              ['GIT_REGEX_PCRE2', 1]
            else if jst.env('REGEX_BACKEND') == 'builtin' then
              ['GIT_REGEX_BUILTIN', 1]
            else if jst.env('REGEX_BACKEND') == null then
              ['GIT_REGEX_BUILTIN', 1]
            else
              jst.fail('The REGEX_BACKEND option provided is not supported'),
          ]
          + (if jst.env('USE_GSSAPI') == 'GSS.framework' then
               [['GIT_GSSFRAMEWORK', 1]]
             else if jst.env('USE_GSSAPI') == 'gssapi' then
               [['GIT_GSSAPI', 1]]
             else if jst.env('USE_GSSAPI') == false then
               []
             else
               jst.fail('Backend asked for in USE_GSSAPI is not supported'))
          + (if jst.env('USE_HTTPS') then
               [
                 ['GIT_HTTPS', 1],
                 if jst.env('USE_HTTPS') == 'SecureTransport' then
                   ['GIT_SECURE_TRANSPORT', 1]
                 else if jst.env('USE_HTTPS') == 'OpenSSL' then
                   ['GIT_OPENSSL', 1]
                 else if jst.env('USE_HTTPS') == 'mbedTLS' then
                   ['GIT_MBEDTLS', 1]
                 else if jst.env('USE_HTTPS') == 'WinHTTP' then
                   ['GIT_WINHTTP', 1]
                 else
                   jst.fail('Backend asked for in USE_HTTPS is not supported'),
               ])
          + (if jst.env('USE_SHA1') == 'CollisionDetection' then
               [['GIT_SHA1_COLLISIONDETECT', 1]]
             else if jst.env('USE_SHA1') == 'Win32' then
               [['GIT_SHA1_WIN32', 1]]
             else if jst.env('USE_SHA1') == 'CommonCrypto' then
               [['GIT_SHA1_COMMON_CRYPTO', 1]]
             else if jst.env('USE_SHA1') == 'OpenSSL' then
               [['GIT_SHA1_OPENSSL', 1]]
             else if jst.env('USE_SHA1') == 'mbedTLS' then
               [['GIT_SHA1_MBEDTLS', 1]])
          + (if jst.env('USE_SHA256') == 'Builtin' then
               [['GIT_SHA256_BUILTIN', 1]]
             else if jst.env('USE_SHA256') == 'Win32' then
               [['GIT_SHA256_WIN32', 1]]
             else if jst.env('USE_SHA256') == 'CommonCrypto' then
               [['GIT_SHA256_COMMON_CRYPTO', 1]]
             else if jst.env('USE_SHA256') == 'OpenSSL' then
               [['GIT_SHA256_OPENSSL', 1]]
             else if jst.env('USE_SHA256') == 'mbedTLS' then
               [['GIT_SHA256_MBEDTLS', 1]]),
        have_csymbol: [
          ['GIT_IO_POLL', ['poll', ['poll.h']]],
          ['GIT_IO_SELECT', ['select', ['sys/select.h']]],
        ],
      },
  },

  feature_header: {
    type: @'rules//CC/auto:config',
    name: ['git2_features.h'],
    guard: ['INCLUDE_features_h__'],
  },
}
