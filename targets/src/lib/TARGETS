// Shared/static selection and shared-object soversion. Mirrors upstream's
// own libtool "CARES_LIB_VERSIONINFO" ("21:7:19": current:revision:age) in
// this release's own CMakeLists.txt, converted the same way its own
// src/lib/CMakeLists.txt does: SOVERSION = current - age = 2,
// VERSION = "<major>.<age>.<revision>" = "2.19.7".
