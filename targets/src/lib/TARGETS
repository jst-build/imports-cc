    'pkg-name': ['libcares'],
    'pure C': ['YES'],
    'private-defines':
      [
        'HAVE_CONFIG_H',
        'CARES_STATICLIB',
      ]
      + if jst.env('OS') == 'darwin' then
        ['_DARWIN_C_SOURCE']
      else if jst.env('OS') == 'linux' then
        [
          '_GNU_SOURCE',
          '_POSIX_C_SOURCE=199309L',
          '_XOPEN_SOURCE=600',
        ]
      else if jst.env('OS') == 'sunos' then
        [
          '__EXTENSIONS__',
          '_REENTRANT',
          '_XOPEN_SOURCE=600',
        ]
