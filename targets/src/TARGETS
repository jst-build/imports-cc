{
  libgit2: {
    type: @'rules//CC:library',
    arguments_config: ['OS', 'ARCH', 'TARGET_ARCH', 'LIBGIT2_BUILD_SHARED'],
    name: ['git2'],
    'pkg-name': ['libgit2'],
    'pure C': ['yes'],
    shared: if $'LIBGIT2_BUILD_SHARED' then ['yes'],
    // Real upstream: SOVERSION "${VERSION_MAJOR}.${VERSION_MINOR}".
    soversion: ['1', '9'],
    'private-defines':
      if jst.env('OS') == 'linux' then
        ['HAVE_QSORT_R_GNU']
      else if jst.env('OS') == 'darwin' || jst.env('OS') == 'bsd' then
        ['HAVE_QSORT_R_BSD']
      else if jst.env('OS') == 'windows' then
        ['HAVE_QSORT_S'],
    'private-cflags':
      if jst.env('TARGET_ARCH', default=jst.env('ARCH')) == 'arm' then
        ['-Wno-atomic-alignment'],
    srcs: [
      @'//src/util:util_sources',
      @'//src/libgit2:libgit2_sources',
    ],
    hdrs: [@'//include:git2_public_headers'],
    'private-hdrs': [@'//src/libgit2:libgit2_private_headers'],
    components: [
      @'//src/util:util_compress',
      @'//src/util:util_gssapi',
      @'//src/util:util_http_parser',
      @'//src/util:util_https',
      @'//src/util:util_ntlmclient',
      @'//src/util:util_os',
      @'//src/util:util_regex',
      @'//src/util:util_sha1',
      @'//src/util:util_sha256',
      @'//src/util:util_ssh',
    ],
  },
}
