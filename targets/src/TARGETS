{
  archive_pthread: {
    type: @'rules//CC:library',
    arguments_config: ['OS'],
    name: ['archive_pthread'],
    'private-ldflags':
      if jst.env('OS') == 'linux' then
        [
          '-pthread',
          '-Wl,--whole-archive,-lpthread,--no-whole-archive',
        ],
  },

  archive_crypt: {
