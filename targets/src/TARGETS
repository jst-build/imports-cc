    arguments_config: ['OS', 'ENABLE_CNG', 'USE_SYSTEM_LIBS'],
    name: ['curl_crypt'],
    'private-ldflags':
      if jst.env('OS') == 'windows' && jst.env('ENABLE_CNG') && jst.env('USE_SYSTEM_LIBS') then
        ['-lbcrypt'],
    deps:
      if jst.env('OS') == 'windows' && jst.env('ENABLE_CNG') && !jst.env('USE_SYSTEM_LIBS') then
        [@'bcrypt//:bcrypt'],
  },

