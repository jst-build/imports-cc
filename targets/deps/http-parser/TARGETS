{
  git2_http_parser: {
    type: @'rules//CC:library',
    arguments_config: ['TOOLCHAIN_CONFIG'],
    name: ['git2_http_parser'],
    'pure C': ['yes'],
    srcs: ['http_parser.c'],
    hdrs: ['http_parser.h'],
    'private-cflags':
      local toolchain_config = jst.env('TOOLCHAIN_CONFIG', default={});
      local compiler_family = jst.get('FAMILY', toolchain_config, default='unknown');
      if compiler_family == 'gnu' then
        ['-Wimplicit-fallthrough=1'],
  },
}
