      'pcre2_extuni.c',
      'pcre2_find_bracket.c',
      'pcre2_maketables.c',
      'pcre2_match.c',
      'pcre2_match_data.c',
      'pcre2_match_next.c',
      'pcre2_newline.c',
      'pcre2_ord2utf.c',
      'pcre2_pattern_info.c',
      'pcre2_script_run.c',
      'pcre2_serialize.c',
      'pcre2_string_utils.c',
      'pcre2_study.c',
      'pcre2_substitute.c',
      'pcre2_substring.c',
      'pcre2_tables.c',
      'pcre2_ucd.c',
      'pcre2_valid_utf.c',
      'pcre2_xclass.c',
