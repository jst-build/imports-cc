          + (if jst.env('OS') == 'linux' then
               [
                 ['RECV_TYPE_ARG1', 'int'],
                 ['RECV_TYPE_ARG2', 'void *'],
                 ['RECV_TYPE_ARG3', 'size_t'],
                 ['RECV_TYPE_ARG4', 'int'],
                 ['RECV_TYPE_RETV', 'ssize_t'],
                 ['SELECT_QUAL_ARG5', ' '],
                 ['SELECT_TYPE_ARG1', 'int'],
                 ['SELECT_TYPE_ARG234', 'fd_set *'],
                 ['SELECT_TYPE_ARG5', 'struct timeval *'],
                 ['SELECT_TYPE_RETV', 'int'],
                 ['SEND_QUAL_ARG2', 'const'],
                 ['SEND_TYPE_ARG1', 'int'],
                 ['SEND_TYPE_ARG2', 'void *'],
                 ['SEND_TYPE_ARG3', 'size_t'],
                 ['SEND_TYPE_ARG4', 'int'],
                 ['SEND_TYPE_RETV', 'ssize_t'],
               ]
             else if jst.env('OS') == 'windows' then
               [
                 ['RECV_TYPE_ARG1', 'SOCKET'],
                 ['RECV_TYPE_ARG2', 'char *'],
                 ['RECV_TYPE_ARG3', 'int'],
                 ['RECV_TYPE_ARG4', 'int'],
                 ['RECV_TYPE_RETV', 'int'],
                 ['SEND_QUAL_ARG2', 'const'],
                 ['SEND_TYPE_ARG1', 'SOCKET'],
                 ['SEND_TYPE_ARG2', 'char *'],
                 ['SEND_TYPE_ARG3', 'int'],
                 ['SEND_TYPE_ARG4', 'int'],
                 ['SEND_TYPE_RETV', 'int'],
               ])
          + (if jst.env('CURL_CA_BUNDLE') == 'auto' || jst.env('CURL_CA_BUNDLE') == 'none' then
               []
             else if jst.env('CURL_CA_BUNDLE') == '' then
               jst.fail("Invalid value of CURL_CA_BUNDLE. Use 'none', 'auto' or file path.")
             else
               [['CURL_CA_BUNDLE', jst.env('CURL_CA_BUNDLE')]])
          + (if jst.env('CURL_CA_PATH') == 'auto' || jst.env('CURL_CA_PATH') == 'none' then
               []
             else if jst.env('CURL_CA_PATH') == '' then
               jst.fail("Invalid value of CURL_CA_PATH. Use 'none', 'auto' or file path.")
             else
               [['CURL_CA_PATH', jst.env('CURL_CA_PATH')]])
          + (if jst.env('ENABLE_UNIX_SOCKETS') && jst.env('OS') == 'windows' then
               [['USE_UNIX_SOCKETS', ' ']])
          + (if compiler_family == 'msvc' then
               [['CURL_EXTERN_SYMBOL', ' ']]
             else
               (if jst.env('CURL_HIDDEN_SYMBOLS') then
                  (if compiler_family == 'clang' then
                     [['CURL_EXTERN_SYMBOL', '__attribute__ ((__visibility__ ("default")))']]
                   else if compiler_family == 'gnu' then
                     [['CURL_EXTERN_SYMBOL', '__attribute__ ((__visibility__ ("default")))']]
                   else if compiler_family == 'sunpro' then
                     [['CURL_EXTERN_SYMBOL', '__global']]
                   else if compiler_family == 'intel' then
                     [['CURL_EXTERN_SYMBOL', '__attribute__ ((__visibility__ ("default")))']]
                   else
                     [['CURL_EXTERN_SYMBOL', ' ']])
                else
                  [['CURL_EXTERN_SYMBOL', ' ']]))
          + [
            ['SIZEOF_CURL_OFF_T', '8'],
            ['SIZEOF_CURL_SOCKET_T', '4'],
            ['SIZEOF_SA_FAMILY_T', '2'],
          ],
      },
  },

