{
  // gtest-all.cc #includes these sibling .cc/.h files via quoted paths
  // relative to the googletest/ root (e.g. "src/gtest-internal-inl.h"), so
  // they must be staged alongside it rather than compiled separately.
  private_hdrs: {
    type: @'rules//data:staged',
    srcs: [
      'gtest-assertion-result.cc',
      'gtest.cc',
      'gtest-death-test.cc',
      'gtest-filepath.cc',
      'gtest-internal-inl.h',
      'gtest-matchers.cc',
      'gtest-port.cc',
      'gtest-printers.cc',
      'gtest-test-part.cc',
      'gtest-typed-test.cc',
    ],
    stage: ['src'],
  },

  gtest_all: {
    type: @'rules//data:staged',
    srcs: ['gtest-all.cc'],
    stage: ['src'],
  },

  gtest_main: {
    type: @'rules//data:staged',
    srcs: ['gtest_main.cc'],
    stage: ['src'],
  },
}
