// Options supported by the libgit2 project
local options_doc = {
  OS: ['Operating system to build for.'],
  ARCH: [|||
    The underlying architecture. Is taken as a default for "TARGET_ARCH".

    Typical values are "x86", "x86_64", "arm", "arm64", but the actual set
    of supported values depends on the toolchain in use.
  |||],
  HOST_ARCH: ['The architecture on which the build actions are carried out.'],
  TARGET_ARCH: ['The architecture for which to build the binary.'],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family. Typical values are
    "clang" and "gnu", but the actual set of supported values depends on
    the toolchain in use.
  |||],
  USE_SYSTEM_LIBS: [|||
    Boolean. Global switch consumed throughout this project's own targets:
    if set, optional dependencies (zlib, ssl, ...) are looked up under
    their system ("system") name rather than their bundled/vendored
    ("open") name.
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CC: ['The C compiler to use.'],
  CFLAGS: ['The C compiler flags to use.'],
  ADD_CFLAGS: ['Additional C compiler flags.'],
  CXX: ['The C++ compiler to use.'],
  CXXFLAGS: ['The C++ compiler flags to use.'],
  ADD_CXXFLAGS: ['Additional C++ compiler flags.'],
  BUILD_POSITION_INDEPENDENT: ['Build as position independent code.'],
  AR: ['The archiver to use.'],
  DWP: ['The DWARF format packaging tool to use. Required by debug builds that enable debug fission.'],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
  USE_THREADS: [|||
    Use threads for parallel processing when possible.
    Set to true/false for using pthreads (Defaults to true).
  |||],
  USE_SSH: [|||
    Enables SSH support and optionally select provider.
    Set to true/false for linking against libssh2 (Defaults to false, since
    no "ssh2" extern is bundled/imported in this repo).
  |||],
  USE_HTTPS: [|||
    true: use "WinHTTP" if ~WINHTTP~ and ~OS=="windows"~
    "SecureTransport": link against Security framework (from system or open name)
    "WinHTTP": link against Windows' libwinhttp (always from system)
    "OpenSSL": link against OpenSSL (from system or open name)
    "mbedTLS": link against mbedTLS (from system or open name)
    false|null: Disable HTTPS
  |||],
  USE_SHA1: [|||
    true: use "CollisionDetection"
    "CollisionDetection": build with shipped SHA1DC implementation
    "OpenSSL": link against OpenSSL compat library (from system or open name)
    "mbedTLS": link against mbedTLS (from system or open name)
    "Win32": link against Windows' SHA1 implementation (always from system)
    "CommonCrypto": build with shipped common_crypto implementation
    "HTTPS": inherit from ~USE_HTTPS~, or fall back to "CollisionDetection"
    (default: must match ~USE_HTTPS~'s resolved backend, or the build fails
    with symbol collisions between the shipped SHA1 headers and the linked
    crypto library's own headers).
  |||],
  USE_SHA256: [|||
    true: use "Builtin"
    "Builtin": build with shipped RFC 6234 implementation
    "OpenSSL": link against OpenSSL compat library (from system or open name)
    "mbedTLS": link against mbedTLS (from system or open name)
    "Win32": link against Windows' SHA1 implementation (always from system)
    "CommonCrypto": build with shipped common_crypto implementation
    "HTTPS": inherit from ~USE_HTTPS~, or fall back to "Builtin"
    (default: must match ~USE_HTTPS~'s resolved backend, or the build fails
    with symbol collisions between the shipped SHA256 headers and the linked
    crypto library's own headers).
  |||],
  USE_HTTP_PARSER: [|||
    "system": link against libhttp_parser (from system or open name)
    <other>: compile and link bundled http_parser (./deps/http-parser)
  |||],
  USE_NTLMCLIENT: [|||
    Enables NTLM authentication support. One of Builtin or win32.
  |||],
  USE_GSSAPI: [|||
    true: use "GSS.framework" for ~OS=="darwin"~ or else "gssapi"
    false: Disable GSS (default, since no "gssapi" extern is
    bundled/imported in this repo)
    "GSS.framework": Link against GSS framework (system or open name)
    "gssapi": Link against libgssapi (system or open name)
  |||],
  REGEX_BACKEND: [|||
    "regcomp_l": compile against regcomp_l (always from system)
    "regcomp": compile against regcomp (always from system)
    "pcre": link against libpcre (from system or open name)
    "pcre2": link against libpcre2 (from system or open name)
    "builtin"|null: compile and link bundled pcre (./deps/pcre)
  |||],
  USE_NSEC: [|||
    Enable nanosecond precision timestamps. boolean. (Defaults to false).
  |||],
  WINHTTP: ['boolean. Use "WinHTTP" if "USE_HTTPS" is true'],
  DEBUG_POOL: ['boolean. Enable debug pool allocator.'],
  USE_ICONV: ['boolean. Use iconv for character conversion.'],
  USE_BUNDLED_ZLIB: ['boolean. Link against bundled zlib compression library.'],
};

{
  // Default target: installs the library and its public headers into a
  // LOCALBASE-shaped tree (include/git2.h, lib/libgit2.a).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['Installs the libgit2 library into a LOCALBASE-style tree.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all libs, binaries, and public headers of
  // this project into a single LOCALBASE-shaped tree.
  INSTALL: {
    type: @'rules//CC:install-with-deps',
    targets: ['git2'],
  },

  git2: {
    type: 'export',
    target: 'git2_configured',
    doc: ['The Git linkable library'],
    flexible_config: jst.keys(options_doc),
    config_doc: options_doc,
  },

  git2_configured: {
    type: 'configure',
    arguments_config: jst.keys(options_doc),
    target: @'./src:libgit2',
    config:
      local os = jst.env('OS', default='linux');
      local use_gssapi = jst.env('USE_GSSAPI', default=false);
      local use_sha1 = jst.env('USE_SHA1', default='HTTPS');
      local use_sha256 = jst.env('USE_SHA256', default='HTTPS');
      local use_https = jst.env('USE_HTTPS', default=true);
      local winhttp = jst.env('WINHTTP', default=(os == 'windows'));
      local use_https =
        if use_https == true then
          (if os == 'windows' then
             (if winhttp then
                'WinHTTP'
              else
                'OpenSSL')
           else
             'OpenSSL')
        else
          use_https;
      {
        USE_SYSTEM_LIBS: jst.env('USE_SYSTEM_LIBS'),
        DEBUG_POOL: jst.env('DEBUG_POOL'),
        USE_THREADS: jst.env('USE_THREADS', default=true),
        REGEX_BACKEND: jst.env('REGEX_BACKEND'),
        USE_ICONV: jst.env('USE_ICONV'),
        USE_NSEC: jst.env('USE_NSEC'),
        USE_SSH: jst.env('USE_SSH', default=false),
        USE_NTLMCLIENT: jst.env('USE_NTLMCLIENT'),
        USE_GSSAPI:
          if use_gssapi == true then
            (if os == 'darwin' then
               'GSS.framework'
             else
               'gssapi')
          else
            use_gssapi,
        USE_SHA1:
          if use_sha1 == true then
            'CollisionDetection'
          else if use_sha1 == 'HTTPS' then
            (if use_https == 'SecureTransport' then
               'CommonCrypto'
             else if use_https == 'WinHTTP' then
               'Win32'
             else if use_https == false then
               'CollisionDetection'
             else if use_https == null then
               'CollisionDetection'
             else
               use_https)
          else
            use_sha1,
        USE_SHA256:
          if use_sha256 == true then
            'Builtin'
          else if use_sha256 == 'HTTPS' then
            (if use_https == 'SecureTransport' then
               'CommonCrypto'
             else if use_https == 'WinHTTP' then
               'Win32'
             else if use_https == false then
               'Builtin'
             else if use_https == null then
               'Builtin'
             else
               use_https)
          else
            use_sha256,
        USE_HTTPS: use_https,
        USE_HTTP_PARSER: jst.env('USE_HTTP_PARSER'),
        USE_BUNDLED_ZLIB: jst.env('USE_BUNDLED_ZLIB'),
      },
  },
}
