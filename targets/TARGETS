// Options supported by this project
local options_doc = {
  OS: ['Operating system to build for.'],
  ARCH: [|||
    The underlying architecture. Is taken as a default for "TARGET_ARCH" if
    that is not set.

    Typical values are "x86", "x86_64", "arm", "arm64", but the actual set
    of supported values depends on the toolchain in use.
  |||],
  TARGET_ARCH: ['The architecture for which to build the binary.'],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family. Typical values are
    "clang" and "gnu", but the actual set of supported values depends on
    the toolchain in use.
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CC: ['The C compiler to use.'],
  CFLAGS: ['The C compiler flags to use.'],
  ADD_CFLAGS: ['Additional C compiler flags.'],
  LDFLAGS: ['The linker flags to use.'],
  ADD_LDFLAGS: ['Additional linker flags.'],
  BUILD_POSITION_INDEPENDENT: ['Build as position independent code.'],
  ZSTD_BUILD_SHARED: [|||
    Boolean. Build a shared ("*.so") library instead of a static ("*.a")
    one. Default "false".
  |||],
  AR: ['The archiver to use.'],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
  ZSTD_LEGACY_SUPPORT: [|||
    Boolean. Default "true". Decode legacy zstd formats (v0.1 through
    v0.5; matches upstream's own default legacy level of 5).
  |||],
  ZSTD_MULTITHREAD_SUPPORT: [|||
    Boolean. Default "true". Enable multi-threaded compression support.
  |||],
  ZSTD_BUILD_COMPRESSION: ['Boolean. Default "true". Include the compression module.'],
  ZSTD_BUILD_DECOMPRESSION: ['Boolean. Default "true". Include the decompression module.'],
  ZSTD_BUILD_DICTBUILDER: ['Boolean. Default "true". Include the dictionary-builder module.'],
  ZSTD_BUILD_DEPRECATED: ['Boolean. Default "false". Include the deprecated buffered-API wrappers.'],
};

{
  // Default target: installs the library and its public headers into a
  // LOCALBASE-shaped tree (include/zstd*.h, lib/libzstd.a).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['Installs the Zstandard library into a LOCALBASE-style tree.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all libs, binaries, and public headers of
  // this project into a single LOCALBASE-shaped tree.
  INSTALL: {
    type: @'rules//CC:install-with-deps',
    targets: ['zstd', 'zstd_cli'],
  },

  // Runs all test targets of this project.
  TESTS: {
    type: @'rules//test:suite',
    deps: [
      @'./tests:golden_decompression_test',
      @'./tests:golden_decompression_errors_test',
      @'./tests:golden_compression_test',
      @'./tests:golden_roundtrip_test',
      @'./tests:cli_version_test',
      @'./tests:cli_help_test',
      @'./tests:cli_args_test',
      @'./tests:cli_memlimit_test',
      @'./tests:cli_output_dir_test',
    ],
  },

  // Zstandard (https://facebook.github.io/zstd/), a fast lossless
  // compression algorithm.
  zstd: {
    type: 'export',
    target: 'zstd_configured',
    doc: ['Zstandard, a fast lossless compression algorithm.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // The zstd command-line compression tool. Exported as "zstd_cli" (not
  // "zstd") to avoid colliding with the library export above; the actual
  // installed binary is still named "zstd", matching upstream. No .gz/.xz/
  // .lz4 passthrough support: matches upstream's own graceful fallback when
  // zlib/liblzma/liblz4 aren't found, since this branch doesn't wire up
  // those optional deps.
  zstd_cli: {
    type: 'export',
    target: 'zstd_cli_unexported',
    doc: ['The zstd command-line compression tool.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Fills in sane defaults for "TARGET_ARCH" (read directly by
  // "zstd_unexported" below) so the library builds without the caller
  // having to set it explicitly.
  zstd_configured: {
    type: 'configure',
    arguments_config: ['ARCH', 'TARGET_ARCH'],
    target: 'zstd_unexported',
    config: {
      TARGET_ARCH: jst.env('TARGET_ARCH', default=jst.env('ARCH', default='x86_64')),
    },
  },

  zstd_unexported: {
    type: @'rules//CC:library',
    arguments_config: [
      'ZSTD_BUILD_SHARED',
      'ZSTD_LEGACY_SUPPORT',
      'ZSTD_MULTITHREAD_SUPPORT',
      'ZSTD_BUILD_COMPRESSION',
      'ZSTD_BUILD_DECOMPRESSION',
      'ZSTD_BUILD_DICTBUILDER',
      'ZSTD_BUILD_DEPRECATED',
    ],
    name: ['zstd'],
    'pkg-name': ['libzstd'],
    'pure C': ['YES'],
    shared: if $'ZSTD_BUILD_SHARED' then ['yes'],
    soversion: ['1', '5', '7'],
    // Real dependency whenever multi-threaded compression is enabled
    // (matches upstream's own "target_link_libraries(... THREADS_LIBS)"
    // on UNIX); also needed at compile time since threading.c always
    // includes <pthread.h> when ZSTD_MULTITHREAD is defined.
    cflags:
      if jst.env('ZSTD_MULTITHREAD_SUPPORT', default=true) then
        ['-pthread'],
    hdrs: [@'./lib:public_headers'],
    // Referenced via private-hdrs (not private-deps) so each module's
    // headers land at their real "lib/<module>/" path inside the work
    // tree - required because these headers include each other via
    // relative paths (e.g. "../common/zstd_internal.h"), which only
    // resolves if the on-disk layout mirrors upstream's real directory
    // structure.
    'private-hdrs':
      [
        @'./lib/common:headers',
      ]
      + (if jst.env('ZSTD_BUILD_COMPRESSION', default=true) then [@'./lib/compress:headers'])
      + (if jst.env('ZSTD_BUILD_DECOMPRESSION', default=true) then [@'./lib/decompress:headers'])
      + (if jst.env('ZSTD_BUILD_DICTBUILDER', default=true) then [@'./lib/dictBuilder:headers'])
      + (if jst.env('ZSTD_BUILD_DEPRECATED', default=false) then [@'./lib/deprecated:headers'])
      + (if jst.env('ZSTD_LEGACY_SUPPORT', default=true) then [@'./lib/legacy:headers']),
    srcs:
      [
        'lib/common/debug.c',
        'lib/common/entropy_common.c',
        'lib/common/error_private.c',
        'lib/common/fse_decompress.c',
        'lib/common/pool.c',
        'lib/common/threading.c',
        'lib/common/xxhash.c',
        'lib/common/zstd_common.c',
      ]
      + (if jst.env('ZSTD_BUILD_COMPRESSION', default=true) then
           [
             'lib/compress/fse_compress.c',
             'lib/compress/hist.c',
             'lib/compress/huf_compress.c',
             'lib/compress/zstd_compress.c',
             'lib/compress/zstd_compress_literals.c',
             'lib/compress/zstd_compress_sequences.c',
             'lib/compress/zstd_compress_superblock.c',
             'lib/compress/zstd_double_fast.c',
             'lib/compress/zstd_fast.c',
             'lib/compress/zstd_lazy.c',
             'lib/compress/zstd_ldm.c',
             'lib/compress/zstdmt_compress.c',
             'lib/compress/zstd_opt.c',
             'lib/compress/zstd_preSplit.c',
           ])
      + (if jst.env('ZSTD_BUILD_DECOMPRESSION', default=true) then
           [
             'lib/decompress/huf_decompress.c',
             'lib/decompress/zstd_ddict.c',
             'lib/decompress/zstd_decompress_block.c',
             'lib/decompress/zstd_decompress.c',
           ])
      + (if jst.env('ZSTD_BUILD_DICTBUILDER', default=true) then
           [
             'lib/dictBuilder/cover.c',
             'lib/dictBuilder/divsufsort.c',
             'lib/dictBuilder/fastcover.c',
             'lib/dictBuilder/zdict.c',
           ])
      + (if jst.env('ZSTD_BUILD_DEPRECATED', default=false) then
           [
             'lib/deprecated/zbuff_common.c',
             'lib/deprecated/zbuff_compress.c',
             'lib/deprecated/zbuff_decompress.c',
           ])
      + (if jst.env('ZSTD_LEGACY_SUPPORT', default=true) then
           [
             'lib/legacy/zstd_v01.c',
             'lib/legacy/zstd_v02.c',
             'lib/legacy/zstd_v03.c',
             'lib/legacy/zstd_v04.c',
             'lib/legacy/zstd_v05.c',
             'lib/legacy/zstd_v06.c',
             'lib/legacy/zstd_v07.c',
           ]),
    'private-defines':
      [
        // xxhash.c is vendored inside common/ - renaming its symbols
        // avoids any collision with a separately linked real xxhash
        // library (matches upstream's own unconditional top-level
        // "add_definitions(-DXXH_NAMESPACE=ZSTD_)").
        'XXH_NAMESPACE=ZSTD_',
        // huf_decompress_amd64.S (a real x86_64-only optimization, gated
        // upstream on both architecture and a "does the assembler mark
        // the stack non-executable" compile-time probe) is left
        // uncompiled - a genuine compile-time choice, not runtime
        // dispatch, so portable-over-optimized is the safer default
        // here (see AGENTS.md §12). huf_decompress.c's own portable C
        // path is used unconditionally instead.
        'ZSTD_DISABLE_ASM',
      ]
      + (if jst.env('ZSTD_MULTITHREAD_SUPPORT', default=true) then
           ['ZSTD_MULTITHREAD'])
      + (if jst.env('ZSTD_LEGACY_SUPPORT', default=true) then
           ['ZSTD_LEGACY_SUPPORT=5']
         else
           ['ZSTD_LEGACY_SUPPORT=0']),
  },

  zstd_cli_unexported: {
    type: @'rules//CC:binary',
    arguments_config: ['ZSTD_LEGACY_SUPPORT', 'ZSTD_MULTITHREAD_SUPPORT'],
    name: ['zstd'],
    'pure C': ['YES'],
    'private-cflags': if jst.env('ZSTD_MULTITHREAD_SUPPORT', default=true) then ['-pthread'],
    'private-ldflags': if jst.env('ZSTD_MULTITHREAD_SUPPORT', default=true) then ['-pthread'],
    'private-deps': ['zstd'],
    'private-hdrs':
      [
        @'./lib/common:headers',
        'programs/benchfn.h',
        'programs/benchzstd.h',
        'programs/datagen.h',
        'programs/dibio.h',
        'programs/fileio.h',
        'programs/fileio_asyncio.h',
        'programs/fileio_common.h',
        'programs/fileio_types.h',
        'programs/lorem.h',
        'programs/platform.h',
        'programs/timefn.h',
        'programs/util.h',
        'programs/zstdcli_trace.h',
      ],
    srcs: [
      'programs/benchfn.c',
      'programs/benchzstd.c',
      'programs/datagen.c',
      'programs/dibio.c',
      'programs/fileio.c',
      'programs/fileio_asyncio.c',
      'programs/lorem.c',
      'programs/timefn.c',
      'programs/util.c',
      'programs/zstdcli.c',
      'programs/zstdcli_trace.c',
    ],
    'private-defines':
      (if jst.env('ZSTD_MULTITHREAD_SUPPORT', default=true) then ['ZSTD_MULTITHREAD'])
      + (if jst.env('ZSTD_LEGACY_SUPPORT', default=true) then
           ['ZSTD_LEGACY_SUPPORT=5']
         else
           ['ZSTD_LEGACY_SUPPORT=0']),
  },
}
