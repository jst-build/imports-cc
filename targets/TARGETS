// Options supported by this project
local options_doc = {
  OS: [|||
    Operating system to build for.

    This is used to select the correct set of platform-specific preprocessor
    defines. Supported values are "darwin", "linux", "sunos", "aix", and
    "windows". Setting it is optional: if left unset (or set to an
    unsupported value), no platform-specific defines are added and the
    build still proceeds.
  |||],
  ARCH: [|||
    The underlying architecture. Is taken as a default for "HOST_ARCH" and
    "TARGET_ARCH".

    Typical values are "x86", "x86_64", "arm", "arm64", but the actual set
    of supported values depends on the toolchain in use.
  |||],
  TARGET_ARCH: ['The architecture for which to build the binary.'],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family. Typical values are
    "clang" and "gnu", but the actual set of supported values depends on
    the toolchain in use.
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CC: ['The C compiler to use.'],
  CFLAGS: ['The C compiler flags to use.'],
  ADD_CFLAGS: ['Additional C compiler flags.'],
  ADD_LDFLAGS: ['Additional linker flags.'],
  BUILD_POSITION_INDEPENDENT: ['Build as position independent code.'],
  CARES_BUILD_SHARED: [|||
    Boolean. Build a shared ("*.so") library instead of a static ("*.a")
    one. Default "false".
  |||],
  AR: ['The archiver to use.'],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
};

{
  // Default target: installs the library and its public headers into a
  // LOCALBASE-shaped tree (include/ares*.h, lib/libcares.a).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['Installs the c-ares library into a LOCALBASE-style tree.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all libs, binaries, and public headers of
  // this project into a single LOCALBASE-shaped tree.
  INSTALL: {
    type: @'rules//CC:install-with-deps',
    targets: ['ares'],
  },

  // c-ares (https://c-ares.org), an asynchronous DNS resolution library.
  ares: {
    type: 'export',
    target: @'//src/lib:ares_unexported',
    doc: ['c-ares (https://c-ares.org), an asynchronous DNS resolution library.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },
}
