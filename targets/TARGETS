// Options supported by this project
local options_doc = {
  OS: ['Operating system to build for.'],
  ARCH: [|||
    The underlying architecture. Is taken as a default for "TARGET_ARCH".

    Typical values are "x86", "x86_64", "arm", "arm64", but the actual set
    of supported values depends on the toolchain in use.
  |||],
  TARGET_ARCH: ['The architecture for which to build the binary.'],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family. Typical values are
    "clang" and "gnu", but the actual set of supported values depends on
    the toolchain in use.
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CXX: ['The C++ compiler to use.'],
  CXXFLAGS: ['The C++ compiler flags to use.'],
  ADD_CXXFLAGS: ['Additional C++ compiler flags.'],
  ADD_LDFLAGS: ['Additional linker flags.'],
  BUILD_POSITION_INDEPENDENT: ['Build as position independent code.'],
  AR: ['The archiver to use.'],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
  GTEST_BUILD_SHARED: [|||
    Boolean. Build shared ("*.so") libraries instead of static ("*.a")
    ones. Default false/off, mirroring upstream's own "BUILD_SHARED_LIBS"
    CMake option.
  |||],
};

{
  // Default target: installs the libraries and public headers into a
  // LOCALBASE-shaped tree (include/gtest/*.h, include/gmock/*.h,
  // lib/libgtest*.a, lib/libgmock*.a).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['Installs the GoogleTest libraries into a LOCALBASE-style tree.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all libs and public headers of this
  // project into a single LOCALBASE-shaped tree.
  INSTALL: {
    type: @'rules//CC:install-with-deps',
    targets: [
      'gtest',
      'gtest_main',
      'gmock',
      'gmock_main',
    ],
  },

  // GoogleTest (https://github.com/google/googletest): gtest, the C++
  // test framework.
  gtest: {
    type: 'export',
    target: 'gtest_unexported',
    doc: ['GoogleTest (https://github.com/google/googletest): gtest, the C++ test framework.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Provides gtest's default main() entry point, for test binaries that
  // don't define their own.
  gtest_main: {
    type: 'export',
    target: 'gtest_main_unexported',
    doc: [|||
      gtest's default main() entry point.

      Link this in addition to "gtest" for test binaries that don't
      define their own main().
    |||],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // GoogleTest (https://github.com/google/googletest): gmock, the C++
  // mocking framework, built on top of gtest.
  gmock: {
    type: 'export',
    target: 'gmock_unexported',
    doc: ['GoogleTest (https://github.com/google/googletest): gmock, the C++ mocking framework.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Provides gmock's default main() entry point (which also initializes
  // gtest), for test binaries that don't define their own.
  gmock_main: {
    type: 'export',
    target: 'gmock_main_unexported',
    doc: [|||
      gmock's default main() entry point.

      Also initializes gtest. Link this in addition to "gmock" for test
      binaries that don't define their own main().
    |||],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  gtest_unexported: {
    type: @'rules//CC:library',
    arguments_config: ['GTEST_BUILD_SHARED'],
    name: ['gtest'],
    'pkg-name': ['gtest'],
    hdrs: [@'./googletest/include/gtest:hdrs'],
    'private-hdrs': [@'./googletest/src:private_hdrs'],
    srcs: [@'./googletest/src:gtest_all'],
    'private-cflags': ['-pthread'],
    shared: if $'GTEST_BUILD_SHARED' then ['yes'],
    soversion: ['1', '15', '2'],
  },

  gtest_main_unexported: {
    type: @'rules//CC:library',
    arguments_config: ['GTEST_BUILD_SHARED'],
    name: ['gtest_main'],
    'pkg-name': ['gtest_main'],
    srcs: [@'./googletest/src:gtest_main'],
    deps: ['gtest'],
    shared: if $'GTEST_BUILD_SHARED' then ['yes'],
    soversion: ['1', '15', '2'],
  },

  gmock_unexported: {
    type: @'rules//CC:library',
    arguments_config: ['GTEST_BUILD_SHARED'],
    name: ['gmock'],
    'pkg-name': ['gmock'],
    hdrs: [@'./googlemock/include/gmock:hdrs'],
    'private-hdrs': [@'./googlemock/src:private_hdrs'],
    srcs: [@'./googlemock/src:gmock_all'],
    deps: ['gtest'],
    'private-cflags': ['-pthread'],
    shared: if $'GTEST_BUILD_SHARED' then ['yes'],
    soversion: ['1', '15', '2'],
  },

  gmock_main_unexported: {
    type: @'rules//CC:library',
    arguments_config: ['GTEST_BUILD_SHARED'],
    name: ['gmock_main'],
    'pkg-name': ['gmock_main'],
    srcs: [@'./googlemock/src:gmock_main'],
    deps: ['gmock'],
    shared: if $'GTEST_BUILD_SHARED' then ['yes'],
    soversion: ['1', '15', '2'],
  },
}
