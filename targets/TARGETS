// Abseil (https://abseil.io): Google's C++ common libraries, built from source.
//
// This is the fully flattened target description: every Abseil component lives
// in this single module. Header/source paths are written relative to the
// archive root (e.g. "absl/base/attributes.h") and the libraries carry no
// "stage" field, so a header staged as "absl/base/attributes.h" is included as
// #include "absl/base/attributes.h" by consumers.

// Global Abseil configuration, read per-target from the effective config.
local os = jst.env('OS', default='linux');
local arch = jst.env('ARCH', default='unknown');
local target_arch = jst.env('TARGET_ARCH', default=arch);
local toolchain_config = jst.env('TOOLCHAIN_CONFIG', default={});
local compiler_family = jst.get('FAMILY', toolchain_config);

// Options supported by this project. Every export target advertises these via
// its flexible_config/config_doc so `jst describe <target>` documents them.
local options_doc = {
  OS: [|||
    Operating system to build for. This project reads it directly to select
    platform-specific link flags (e.g. "-lrt" on "linux", "-ladvapi32" for
    mingw) and, in the random seed generator, whether to link the system
    bcrypt on "windows". Typical values are "linux", "darwin", "windows";
    defaults to "linux" when unset.
  |||],
  ARCH: [|||
    The underlying architecture. Passed through to the toolchain and used as
    the default for "TARGET_ARCH". Typical values are "x86_64", "arm64", but
    the actual set of supported values depends on the toolchain in use.
    Defaults to "unknown" when unset.
  |||],
  HOST_ARCH: [|||
    Architecture of the machine running the build; consumed by the toolchain.
    Typical values are "x86_64", "arm64", but the actual set of supported
    values depends on the toolchain in use.
  |||],
  TARGET_ARCH: [|||
    The architecture to build for. This project reads it directly to select
    CPU-specific compile flags (e.g. "-maes"/"-msse4.1" on "x86_64",
    "-march=armv8-a+crypto" on "arm64", "-mfpu=neon" on "arm") and to decide
    whether to link "-latomic". Defaults to "ARCH" (which itself defaults to
    "unknown", a value that enables the "-latomic" fallback).
  |||],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration. This project reads its "FAMILY" field to
    select compiler-specific warning flags and code paths; recognized values
    include "gnu", "clang", "msvc", "clang-cl", and "mingw", with any other
    value falling back to a generic GCC-style flag set. The full set of
    supported values ultimately depends on the toolchain in use.
  |||],
  ENV: [|||
    Map from strings to strings. The build environment to be used for build
    actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CC: ['The C compiler to use.'],
  CXX: ['The C++ compiler to use.'],
  AR: ['The archiver to use.'],
  DWP: ['The dwp tool to use for split-DWARF debug packaging.'],
  PATCH: ['The patch tool used to apply the bundled options.h patch.'],
  CFLAGS: ['The C compiler flags to use.'],
  CXXFLAGS: ['The C++ compiler flags to use.'],
  ADD_CFLAGS: ['Additional C compiler flags.'],
  ADD_CXXFLAGS: ['Additional C++ compiler flags.'],
  ADD_LDFLAGS: ['Additional linker flags.'],
  BUILD_POSITION_INDEPENDENT: ['Build as position independent code.'],
  USE_SYSTEM_LIBS: [|||
    If set, prefer system libraries. This project reads it in the random seed
    generator to link the system "bcrypt" (Windows only) instead of a bundled
    dependency. Has no effect on other platforms.
  |||],
};

