// Options supported by this project
local options_doc = {
  OS: [|||
    Operating system to build for.

    This project itself also reads this value directly: on "windows" it
    adds "-DLZMA_API_STATIC" (required when statically linking liblzma on
    Windows). Any other value (or leaving it unset) is fine and simply
    skips that define.
  |||],
  ARCH: [|||
    The underlying architecture. Used as a default for "TARGET_ARCH" if that
    is not set.

    Typical values are "x86", "x86_64", "arm", "arm64", but the actual set
    of supported values depends on the toolchain in use.
  |||],
  TARGET_ARCH: [|||
    The architecture for which to build the binary.

    This project itself also reads this value directly: on "x86"/"x86_64"
    it enables some SIMD-accelerated code paths (immintrin.h-based CRC
    computation, plus CLMUL on "x86_64"). Any other value (or leaving it
    unset, in which case it defaults from "ARCH") builds without those
    accelerations.
  |||],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family. Typical values are
    "clang" and "gnu", but the actual set of supported values depends on
    the toolchain in use.
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CC: ['The C compiler to use.'],
  CFLAGS: ['The C compiler flags to use.'],
  ADD_CFLAGS: ['Additional C compiler flags.'],
  ADD_LDFLAGS: ['Additional linker flags.'],
  BUILD_POSITION_INDEPENDENT: ['Build as position independent code.'],
  AR: ['The archiver to use.'],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
  ENABLE_SMALL: ['Boolean. Default value: false. Reduce code size at expense of speed.'],
  ADDITIONAL_CHECK_TYPES: ['Boolean. Default value: true. Support additional crc64/sha256 checks.'],
  ENABLE_THREADS: ['Boolean. Default value: true. Support threading.'],
  ENCODERS: ['Boolean. Default value: true. Include encoder support.'],
  DECODERS: ['Boolean. Default value: true. Include decoder support.'],
  LZIP_DECODER: ['Boolean. Default value: true. Support lzip decoder.'],
};

{
  // Default target: installs the library and its public headers into a
  // LOCALBASE-shaped tree (include/lzma*.h, lib/liblzma.a).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['Installs the LZMA library into a LOCALBASE-style tree.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all libs, binaries, and public headers of
  // this project into a single LOCALBASE-shaped tree.
  INSTALL: {
    type: @'rules//CC:install-with-deps',
    targets: ['lzma'],
  },

  // The LZMA (xz) compression library.
  lzma: {
    type: 'export',
    target: 'lzma_configured',
    doc: ['The LZMA (xz) linkable compression library.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Fills in sane defaults for "OS"/"TARGET_ARCH" (required by
  // "lzma_unexported"'s own preprocessor-define selection below) so the
  // library builds without the caller having to set them explicitly.
  lzma_configured: {
    type: 'configure',
    arguments_config: [
      'OS',
      'ARCH',
      'TARGET_ARCH',
      'ENABLE_SMALL',
      'ENABLE_THREADS',
      'ENCODERS',
      'DECODERS',
      'LZIP_DECODER',
    ],
    target: 'lzma_unexported',
    config:
      {
        OS: jst.env('OS', default='linux'),
        TARGET_ARCH: jst.env('TARGET_ARCH', default=jst.env('ARCH', default='x86_64')),
        ENABLE_SMALL: jst.env('ENABLE_SMALL', default=false),
        ADDITIONAL_CHECK_TYPES: jst.env('ADDITIONAL_CHECK_TYPES', default=true),
        ENABLE_THREADS: jst.env('ENABLE_THREADS', default=true),
        ENCODERS: jst.env('ENCODERS', default=true),
        DECODERS: jst.env('DECODERS', default=true),
        LZIP_DECODER: jst.env('LZIP_DECODER', default=true),
      },
  },

  lzma_unexported: {
    type: @'rules//CC:library',
    arguments_config: [
      'OS',
      'TARGET_ARCH',
      'ENABLE_SMALL',
      'ADDITIONAL_CHECK_TYPES',
      'ENABLE_THREADS',
      'ENCODERS',
      'DECODERS',
      'LZIP_DECODER',
    ],
    name: ['lzma'],
    'pkg-name': ['liblzma'],
    'pure C': ['YES'],
    cflags:
      if jst.env('ENABLE_THREADS') then
        ['-pthread'],
    'private-cflags':
      (if jst.env('ENABLE_SMALL') then
         ['-DHAVE_SMALL'])
      + (if jst.env('ADDITIONAL_CHECK_TYPES') then
           [
             '-DHAVE_CHECK_CRC64',
             '-DHAVE_CHECK_SHA256',
           ])
      + (if jst.env('MATCH_FINDERS', default=true) then
           [
             '-DHAVE_MF_HC3',
             '-DHAVE_MF_HC4',
             '-DHAVE_MF_BT2',
             '-DHAVE_MF_BT3',
             '-DHAVE_MF_BT4',
           ])
      + (if jst.env('ENABLE_THREADS') then
           ['-DMYTHREAD_POSIX'])
      + (if jst.env('ENCODERS') then
           [
             '-DHAVE_ENCODERS',
             '-DHAVE_ENCODER_LZMA1',
             '-DHAVE_ENCODER_LZMA2',
             '-DHAVE_ENCODER_X86',
             '-DHAVE_ENCODER_ARM',
             '-DHAVE_ENCODER_ARMTHUMB',
             '-DHAVE_ENCODER_ARM64',
             '-DHAVE_ENCODER_POWERPC',
             '-DHAVE_ENCODER_IA64',
             '-DHAVE_ENCODER_SPARC',
             '-DHAVE_ENCODER_DELTA',
           ])
      + (if jst.env('DECODERS') then
           [
             '-DHAVE_DECODERS',
             '-DHAVE_DECODER_LZMA1',
             '-DHAVE_DECODER_LZMA2',
             '-DHAVE_DECODER_X86',
             '-DHAVE_DECODER_ARM',
             '-DHAVE_DECODER_ARMTHUMB',
             '-DHAVE_DECODER_ARM64',
             '-DHAVE_DECODER_POWERPC',
             '-DHAVE_DECODER_IA64',
             '-DHAVE_DECODER_SPARC',
             '-DHAVE_DECODER_DELTA',
           ])
      + (if jst.env('LZIP_DECODER') then
           ['-DHAVE_LZIP_DECODER'])
      + [
        '-DHAVE_CLOCK_GETTIME',
        '-DHAVE_DECL_CLOCK_MONOTONIC',
        '-DHAVE_PTHREAD_CONDATTR_SETCLOCK',
        '-DTUKLIB_SYMBOL_PREFIX=lzma_',
        '-DHAVE_FUNC_ATTRIBUTE_CONSTRUCTOR',
        '-DHAVE_CPUID_H',
        '-DHAVE_VISIBILITY=0',
      ]
      + (if jst.env('TARGET_ARCH') == 'x86' then
           [
             '-DHAVE_IMMINTRIN_H',
             '-DHAVE__MM_MOVEMASK_EPI8',
           ]
         else if jst.env('TARGET_ARCH') == 'x86_64' then
           [
             '-DHAVE_IMMINTRIN_H',
             '-DHAVE__MM_MOVEMASK_EPI8',
             '-DHAVE_USABLE_CLMUL',
           ])
      + (if jst.env('OS') == 'windows' then
           ['-DLZMA_API_STATIC']),
    hdrs: [@'//src/liblzma/api:public_headers'],
    srcs:
      [
        'src/liblzma/check/check.c',
        'src/liblzma/common/block_util.c',
        'src/liblzma/common/common.c',
        'src/liblzma/common/easy_preset.c',
        'src/liblzma/common/filter_common.c',
        'src/liblzma/common/hardware_physmem.c',
        'src/liblzma/common/index.c',
        'src/liblzma/common/stream_flags_common.c',
        'src/liblzma/common/string_conversion.c',
        'src/liblzma/common/vli_size.c',
      ]
      + (if jst.env('ENABLE_SMALL') then
           ['src/liblzma/check/crc32_small.c']
         else
           @'//src/liblzma/check/crc32_fast.c:src/liblzma/check/crc32_table.c')
      + (if jst.env('ADDITIONAL_CHECK_TYPES') then

           if jst.env('ENABLE_SMALL') then
             ['src/liblzma/check/crc64_small.c']
           else
             @'//src/liblzma/check/crc64_fast.c:src/liblzma/check/crc64_table.c')
      + (if jst.env('ADDITIONAL_CHECK_TYPES') then
           ['src/liblzma/check/sha256.c'])
      + (if jst.env('ENABLE_THREADS') then
           [
             'src/common/tuklib_cpucores.c',
             'src/liblzma/common/hardware_cputhreads.c',
             'src/liblzma/common/outqueue.c',
           ])
      + (if jst.env('ENCODERS') then
           [
             'src/liblzma/common/alone_encoder.c',
             'src/liblzma/common/block_buffer_encoder.c',
             'src/liblzma/common/block_encoder.c',
             'src/liblzma/common/block_header_encoder.c',
             'src/liblzma/common/easy_buffer_encoder.c',
             'src/liblzma/common/easy_encoder.c',
             'src/liblzma/common/easy_encoder_memusage.c',
             'src/liblzma/common/filter_buffer_encoder.c',
             'src/liblzma/common/filter_encoder.c',
             'src/liblzma/common/filter_flags_encoder.c',
             'src/liblzma/common/index_encoder.c',
             'src/liblzma/common/stream_buffer_encoder.c',
             'src/liblzma/common/stream_encoder.c',
             'src/liblzma/common/stream_flags_encoder.c',
             'src/liblzma/common/vli_encoder.c',
           ]
           + (if jst.env('ENABLE_THREADS') then
                ['src/liblzma/common/stream_encoder_mt.c'])
           + [
             'src/liblzma/simple/simple_encoder.c',
             'src/liblzma/lzma/lzma_encoder.c',
             'src/liblzma/lzma/lzma_encoder_optimum_fast.c',
             'src/liblzma/lzma/lzma_encoder_optimum_normal.c',
             'src/liblzma/lz/lz_encoder.c',
             'src/liblzma/lz/lz_encoder_mf.c',
             'src/liblzma/rangecoder/price_table.c',
             'src/liblzma/lzma/lzma2_encoder.c',
             'src/liblzma/delta/delta_encoder.c',
             'extra_sources',
           ]
           + (if !jst.env('ENABLE_SMALL') then
                ['src/liblzma/lzma/fastpos_table.c']))
      + (if jst.env('DECODERS') then
           [
             'src/liblzma/common/alone_decoder.c',
             'src/liblzma/common/auto_decoder.c',
             'src/liblzma/common/block_buffer_decoder.c',
             'src/liblzma/common/block_decoder.c',
             'src/liblzma/common/block_header_decoder.c',
             'src/liblzma/common/easy_decoder_memusage.c',
             'src/liblzma/common/file_info.c',
             'src/liblzma/common/filter_buffer_decoder.c',
             'src/liblzma/common/filter_decoder.c',
             'src/liblzma/common/filter_flags_decoder.c',
             'src/liblzma/common/index_decoder.c',
             'src/liblzma/common/index_hash.c',
             'src/liblzma/common/stream_buffer_decoder.c',
             'src/liblzma/common/stream_decoder.c',
             'src/liblzma/common/stream_flags_decoder.c',
             'src/liblzma/common/vli_decoder.c',
           ]
           + (if jst.env('ENABLE_THREADS') then
                ['src/liblzma/common/stream_decoder_mt.c'])
           + [
             'src/liblzma/simple/simple_decoder.c',
             'src/liblzma/lzma/lzma_decoder.c',
             'src/liblzma/lz/lz_decoder.c',
             'src/liblzma/lzma/lzma2_decoder.c',
             'src/liblzma/delta/delta_decoder.c',
             'extra_sources',
           ])
      + (if jst.env('LZIP_DECODER') then
           ['src/liblzma/common/lzip_decoder.c']),
    'private-deps': [
      @'//src/common:headers',
      @'//src/liblzma/check:headers',
      @'//src/liblzma/common:headers',
    ],
  },

  extra_sources: {
    type: 'install',
    deps: [
      'src/liblzma/delta/delta_common.c',
      'src/liblzma/lzma/lzma_encoder_presets.c',
      'src/liblzma/simple/arm.c',
      'src/liblzma/simple/arm64.c',
      'src/liblzma/simple/armthumb.c',
      'src/liblzma/simple/ia64.c',
      'src/liblzma/simple/powerpc.c',
      'src/liblzma/simple/simple_coder.c',
      'src/liblzma/simple/sparc.c',
      'src/liblzma/simple/x86.c',
    ],
  },
}
