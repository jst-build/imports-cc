// Options supported by this project
local options_doc = {
  OS: ['Operating system to build for.'],
  ARCH: [|||
    The underlying architecture. Is taken as a default for "TARGET_ARCH".

    Typical values are "x86", "x86_64", "arm", "arm64", but the actual set
    of supported values depends on the toolchain in use.
  |||],
  TARGET_ARCH: ['The architecture for which to build the binary.'],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family. Typical values are
    "clang" and "gnu", but the actual set of supported values depends on
    the toolchain in use.
  |||],
  USE_SYSTEM_LIBS: [|||
    Boolean. Global switch consumed throughout this project's own targets:
    if set, optional dependencies (zlib, bzip2, lzma, ...) are looked up
    under their system ("system") name rather than their bundled/vendored
    ("open") name.
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CC: ['The C compiler to use.'],
  CFLAGS: ['The C compiler flags to use.'],
  ADD_CFLAGS: ['Additional C compiler flags.'],
  CXX: ['The C++ compiler to use.'],
  CXXFLAGS: ['The C++ compiler flags to use.'],
  ADD_CXXFLAGS: ['Additional C++ compiler flags.'],
  AR: ['The archiver to use.'],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
  ENABLE_MBEDTLS: ['Boolean. Link against mbedtls (system or open name).'],
  ENABLE_NETTLE: ['Boolean. Link against nettle (system or open name).'],
  ENABLE_OPENSSL: [
    'Boolean. Default value: true, unless ~OS=="darwin"~.',
    'Link against OpenSSL (system or open name).',
  ],
  ENABLE_LIBB2: ['Boolean. Link against libb2 (system or open name).'],
  ENABLE_LZ4: ['Boolean. Link against lz4 (system or open name).'],
  ENABLE_LZO: ['Boolean. Link against lzo (system or open name).'],
  ENABLE_LZMA: ['Boolean. Default value: true. Link against lzma (system or open name).'],
  ENABLE_ZSTD: ['Boolean. Link against zstd (system or open name).'],
  ENABLE_ZLIB: ['Boolean. Default value: true. Link against zlib (system or open name).'],
  ENABLE_BZip2: ['Boolean. Default value: true. Link against libbz2 (system or open name).'],
  ENABLE_LIBXML2: [
    'Boolean. Link against libxml2 (system or open name).',
    'Value used only if ENABLE_ICONV==true.',
  ],
  ENABLE_EXPAT: ['Boolean. Link against EXPAT (system or open name).'],
  ENABLE_PCREPOSIX: ['Boolean. Link against PCREPOSIX (system or open name).'],
  ENABLE_PCRE2POSIX: ['Boolean. Default value: same as ENABLE_PCREPOSIX. Link against PCRE2POSIX (system or open name).'],
  ENABLE_LIBGCC: ['Boolean. Link against LIBGCC (system or open name).'],
  ENABLE_CNG: [
    'Boolean. Use CNG (Crypto Next Generation).',
    'Disabled if not ~OS=="windows"~.',
  ],
  ENABLE_XATTR: ['Boolean. Default value: true. Enable extended attribute support.'],
  ENABLE_ACL: ['Boolean. Link against ACL (system or open name).'],
  ENABLE_ICONV: ['Boolean. Default value: true. Enable iconv support.'],
  ENABLE_LIBMD: [
    'Boolean. Link against libmd (system or open name).',
    'Disabled if ~ENABLE_OPENSSL==true~.',
  ],
  ENABLE_PCRE: ['Boolean. Link against pcre (system or open name).'],
  ENABLE_PCRE2: ['Boolean. Link against pcre2 (system or open name).'],
  ENABLE_REGEX: ['Boolean. Link against regex (system or open name).'],
  XATTR_PROVIDER: [
    '"attr": Link against attr (system or open name) for xattr support.',
    '"gnu": Default value. Xattr support provided natively.',
    '"none"|null: No xattr support. Build fails if ~ENABLE_XATTR==true~.',
  ],
  ENABLE_RICHACL: ['Boolean. Link against RichACL (system or open name).'],
  USE_NFS4: ['Boolean. Default value: true. Explicitly give the NFS4 support state for the target OS.'],
  HIDE_SYMBOLS: [
    'Boolean. Default value: true.',
    'Hide all symbols not officially external.',
    'Has effect if',
    'TOOLCHAIN_CONFIG["FAMILY"] == "clang"|"gnu"|"intel".',
  ],
};

{
  // Default target: installs the library and its public headers into a
  // LOCALBASE-shaped tree (include/archive.h, lib/libarchive.a).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['Installs the libarchive library into a LOCALBASE-style tree.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all libs, binaries, and public headers of
  // this project into a single LOCALBASE-shaped tree.
  INSTALL: {
    type: @'rules//CC:install-with-deps',
    targets: ['archive'],
  },

  // libarchive (https://libarchive.org), a library for reading/writing
  // streaming archives.
  archive: {
    type: 'export',
    target: 'archive_configured',
    doc: ['libarchive (https://libarchive.org), a library for reading/writing streaming archives.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  archive_configured: {
    type: 'configure',
    arguments_config: [
      'OS',
      'ARCH',
      'TARGET_ARCH',
      'TOOLCHAIN_CONFIG',
      'USE_SYSTEM_LIBS',
      'DEBUG',
      'HIDE_SYMBOLS',
      'ENABLE_MBEDTLS',
      'ENABLE_NETTLE',
      'ENABLE_OPENSSL',
      'ENABLE_LIBB2',
      'ENABLE_LZ4',
      'ENABLE_LZO',
      'ENABLE_LZMA',
      'ENABLE_ZSTD',
      'ENABLE_ZLIB',
      'ENABLE_BZip2',
      'ENABLE_LIBXML2',
      'ENABLE_EXPAT',
      'ENABLE_PCREPOSIX',
      'ENABLE_PCRE2POSIX',
      'ENABLE_LIBGCC',
      'ENABLE_CNG',
      'ENABLE_XATTR',
      'ENABLE_ACL',
      'ENABLE_ICONV',
      'ENABLE_LIBMD',
      'ENABLE_PCRE',
      'ENABLE_PCRE2',
      'ENABLE_REGEX',
      'XATTR_PROVIDER',
      'ENABLE_RICHACL',
      'USE_NFS4',
    ],
    target: @'./libarchive:libarchive',
    config:
      local os = jst.env('OS', default='linux');
      // TODO: Fix if-statement
      local enable_openssl =
        /*if jst.env('ENABLE_OPENSSL') == true then os != 'darwin' else*/
        os != 'darwin';
      // TODO: Fix if-statement
      local enable_libxml2 =
        /*if jst.env('ENABLE_LIBXML2') == true then jst.env('ENABLE_ICONV') else*/
        jst.env('ENABLE_ICONV', default=false);
      local enable_pcreposix = jst.env('ENABLE_PCREPOSIX', default=false);
      local enable_xattr = jst.env('ENABLE_XATTR', default=true);
      {
        USE_SYSTEM_LIBS: jst.env('USE_SYSTEM_LIBS'),
        DEBUG: jst.env('DEBUG'),
        ENABLE_MBEDTLS: jst.env('ENABLE_MBEDTLS', default=false),
        ENABLE_NETTLE: jst.env('ENABLE_NETTLE', default=false),
        ENABLE_OPENSSL: enable_openssl,
        ENABLE_LIBB2: jst.env('ENABLE_LIBB2', default=false),
        ENABLE_LZ4: jst.env('ENABLE_LZ4', default=false),
        ENABLE_LZO: jst.env('ENABLE_LZO', default=false),
        ENABLE_LZMA: jst.env('ENABLE_LZMA', default=true),
        ENABLE_ZSTD: jst.env('ENABLE_ZSTD', default=false),
        ENABLE_ZLIB: jst.env('ENABLE_ZLIB', default=true),
        ENABLE_BZip2: jst.env('ENABLE_BZip2', default=true),
        ENABLE_LIBXML2: enable_libxml2,
        // TODO: Fix if-statement
        ENABLE_EXPAT:
          /*if jst.env('ENABLE_EXPAT') == true then !enable_libxml2 else */
          jst.env('ENABLE_EXPAT', default=false),
        ENABLE_PCREPOSIX: enable_pcreposix,
        ENABLE_PCRE2POSIX: jst.env('ENABLE_PCRE2POSIX', default=enable_pcreposix),
        ENABLE_LIBGCC: jst.env('ENABLE_LIBGCC', default=false),
        ENABLE_CNG: jst.env('ENABLE_CNG') == true && os == 'windows',
        ENABLE_XATTR: enable_xattr,
        ENABLE_ACL: jst.env('ENABLE_ACL', default=false),
        ENABLE_ICONV: jst.env('ENABLE_ICONV', default=true),
        ENABLE_LIBMD: jst.env('ENABLE_LIBMD') == true && !enable_openssl,
        ENABLE_PCRE: jst.env('ENABLE_PCRE', default=false),
        ENABLE_PCRE2: jst.env('ENABLE_PCRE2', default=false),
        ENABLE_REGEX: jst.env('ENABLE_REGEX', default=false),
        XATTR_PROVIDER:
          if jst.env('XATTR_PROVIDER', default='gnu') == 'none' then
            (if enable_xattr then
               jst.fail('Extended attributes support was enabled, but providing library not specified.')
             else
               'none')
          else
            jst.env('XATTR_PROVIDER', default='gnu'),
        ENABLE_RICHACL: jst.env('ENABLE_RICHACL', default=false),
        USE_NFS4: jst.env('USE_NFS4', default=true),
        HIDE_SYMBOLS: jst.env('HIDE_SYMBOLS', default=true),
      },
  },
}
