// Options supported by this project
local options_doc = {
  OS: ['Operating system to build for.'],
  ARCH: [|||
    The underlying architecture. Is taken as a default for "HOST_ARCH" and
    "TARGET_ARCH".

    Typical values are "x86", "x86_64", "arm", "arm64", but the actual set
    of supported values depends on the toolchain in use.
  |||],
  TARGET_ARCH: ['The architecture for which to build the binary.'],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family. Typical values are
    "clang" and "gnu", but the actual set of supported values depends on
    the toolchain in use.
  |||],
  DEBUG: [|||
    Map enabling and configuring the debug version. Specify a map that is
    logically true (e.g., non-null, non-empty map) to enable debug mode.
  |||],
  CXX: ['The C++ compiler to use.'],
  CXXFLAGS: ['The C++ compiler flags to use.'],
  ADD_CXXFLAGS: ['Additional C++ compiler flags.'],
  AR: ['The archiver to use.'],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  LOCALBASE: [|||
    Use this localbase for building against system libs (e.g. "/usr").
  |||],
  PKG_CONFIG_ARGS: [|||
    Additional "pkg-config" arguments (e.g. "--define-prefix" or "--static").
  |||],
};

{
  // Default target: installs the libraries and public headers into a
  // LOCALBASE-shaped tree (include/catch2/*.hpp, lib/libCatch2*.a).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['Installs the Catch2 libraries into a LOCALBASE-style tree.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all libs, binaries, and public headers of
  // this project into a single LOCALBASE-shaped tree.
  INSTALL: {
    type: @'rules//CC:install-with-deps',
    targets: [
      'catch2',
      'catch2_main',
    ],
  },

  // Catch2 (https://github.com/catchorg/Catch2), the C++ testing framework.
  catch2: {
    type: 'export',
    target: 'catch2_unexported',
    doc: ['Catch2 (https://github.com/catchorg/Catch2), the C++ testing framework.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Provides Catch2's default main() entry point, for test binaries that
  // don't define their own.
  catch2_main: {
    type: 'export',
    target: 'catch2_main_unexported',
    doc: [|||
      Catch2's default main() entry point.

      Link this in addition to "catch2" for test binaries that don't define
      their own main().
    |||],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Generates catch2/catch_user_config.hpp from the upstream cmakedefine
  // template, with a fixed default reporter/console width (rather than
  // leaving them to whatever ships in the template).
  catch2_config_header_blueprint: {
    type: @'rules//CC/auto:config_file',
    input: [@'./src/catch2:catch_user_config.hpp.in'],
    output: [
      'catch2',
      'catch_user_config.hpp',
    ],
    magic_string: ['cmakedefine'],
    '@only': ['true'],
  },

  catch2_config_header: {
    type: 'configure',
    target: 'catch2_config_header_blueprint',
    config: {
      defines: [
        ['CATCH_CONFIG_DEFAULT_REPORTER', 'console'],
        ['CATCH_CONFIG_CONSOLE_WIDTH', '80'],
      ],
    },
  },

  catch2_unexported: {
    type: @'rules//CC:library',
    name: ['Catch2'],
    'pkg-name': ['catch2'],
    hdrs: [
      @'./src/catch2:hdrs',
      'catch2_config_header',
    ],
    srcs: [@'./src/catch2:srcs'],
  },

  catch2_main_unexported: {
    type: @'rules//CC:library',
    name: ['Catch2Main'],
    'pkg-name': ['catch2-with-main'],
    hdrs: ['catch2_config_header'],
    srcs: [@'./src/catch2:main'],
    deps: ['catch2'],
  },
}
