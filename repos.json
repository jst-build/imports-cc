    },
    "toolchain/rules": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/rules-cc",
        "branch": "master",
        "commit": "c18d9413f8759f8c261a3af06edf0861ee9e2492",
        "subdir": "rules"
      }
    },
    "toolchain/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/toolchains-cc.git",
        "branch": "system",
        "commit": "5505965c61432dea016055d0f12f483df40eb9ff",
        "subdir": "targets"
      }
    }
  }
}