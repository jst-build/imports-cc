        "subdir": "rules"
      }
    },
    "toolchain/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/toolchains-cc.git",
        "branch": "system",
        "commit": "93ba90ae5752d72041eb9849ad53e66c82826e20",
        "subdir": "targets"
      }
    }
