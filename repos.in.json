{
  "main": "grpc",
  "imports": [
    {
      "source": "git",
      "branch": "system",
      "url": "https://github.com/jst-build/toolchains-cc.git",
      "repos": [{"alias": "toolchain"}]
    },
    {
      "source": "git",
      "branch": "absl/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "absl"}]
    },
    {
      "source": "git",
      "branch": "zlib/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "zlib"}]
    },
    {
      "source": "git",
      "branch": "protobuf/v35.1",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{
        "alias": "protobuf",
        "map":{"toolchain": "toolchain", "absl": "absl", "zlib": "zlib"}
      }]
    },
    {
      "source": "git",
      "branch": "protobuf/v35.1",
      "url": "https://github.com/jst-build/toolchains-cc.git",
      "repos": [
        {
          "alias": "proto_toolchain",
          "map": {"base_toolchain": "toolchain", "protobuf": "protobuf"}
        }
      ]
    },
    {
      "source": "git",
      "branch": "ssl/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "ssl"}]
    },
    {
      "source": "git",
      "branch": "re2/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "re2"}]
    },
    {
      "source": "git",
      "branch": "cares/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "cares"}]
    }
  ],
  "repositories": {
    "config": {"repository": {"type": "file", "path": "config"}},
    "targets": {"repository": {"type": "file", "path": "targets"}},
    "rules": {
      "repository": "proto_toolchain",
      "target_root": "config",
      "rule_root": "proto_toolchain",
      "bindings": {"base": "proto_toolchain"}
    },
    "grpc": {
      "repository": {
        "type": "archive",
        "content": "d16a5027f4e5d133c926867711bc782b9d9764e2",
        "fetch": "https://github.com/grpc/grpc/archive/refs/tags/v1.83.0.tar.gz",
        "sha256": "90d453393a9d41215df546103b10b33b9566df79cdf6f49dc67f6c4d044d090d",
        "sha512": "6bc1fa040a5087522f8b8292e00d289105e1343883290432e8327f9bca23248b31c95ef8d6954cad1fc9be7a4c1042cbfedc458da2e11de251e980a44ec753a4",
        "subdir": "grpc-1.83.0",
        "pragma": {"special": "ignore"}
      },
      "target_root": "targets",
      "bindings": {
        "rules": "rules",
        "protobuf": "protobuf",
        "ssl": "ssl",
        "absl": "absl",
        "zlib": "zlib",
        "re2": "re2",
        "cares": "cares"
      }
    }
  }
}
