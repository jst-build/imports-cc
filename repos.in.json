{
  "main": "libarchive",
  "imports": [
    {
      "source": "git",
      "branch": "system",
      "url": "https://github.com/jst-build/toolchains-cc.git",
      "repos": [{"alias": "toolchain"}]
    }
  ],
  "repositories": {
    "targets": {"repository": {"type": "file", "path": "targets"}},
    "libarchive": {"repository": "targets", "bindings": {"rules": "toolchain"}}
  }
}
