{
  "main": "grpc",
  "imports": [
    {
      "source": "git",
      "branch": "system",
      "url": "https://github.com/jst-build/toolchains-cc.git",
      "repos": [{"alias": "toolchain"}]
    },
    {
      "source": "git",
      "branch": "absl/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "absl"}]
    },
    {
      "source": "git",
      "branch": "zlib/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "zlib"}]
    },
    {
      "source": "git",
      "branch": "protobuf/v29.0",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{
        "alias": "protobuf",
        "map":{"toolchain": "toolchain", "absl": "absl", "zlib": "zlib"}
      }]
    },
    {
      "source": "git",
      "branch": "protobuf/v29.0",
      "url": "https://github.com/jst-build/toolchains-cc.git",
      "repos": [
        {
          "alias": "proto_toolchain",
          "map": {"base_toolchain": "toolchain", "protobuf": "protobuf"}
        }
      ]
    },
    {
      "source": "git",
      "branch": "ssl/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "ssl"}]
    },
    {
      "source": "git",
      "branch": "re2/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "re2"}]
    },
    {
      "source": "git",
      "branch": "cares/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "cares"}]
    }
  ],
  "repositories": {
    "config": {"repository": {"type": "file", "path": "config"}},
    "targets": {"repository": {"type": "file", "path": "targets"}},
    "rules": {
      "repository": "proto_toolchain",
      "target_root": "config",
      "rule_root": "proto_toolchain",
      "bindings": {"base": "proto_toolchain"}
    },
    "grpc": {
      "repository": {
        "type": "archive",
        "content": "87c37bc5be5d6ded368667d02958d488b94d6143",
        "fetch": "https://github.com/grpc/grpc/archive/refs/tags/v1.70.2.tar.gz",
        "sha256": "92f240f7267ed6cd8ba2be4c59a3b5b6ec0c4b4c466071b1e1d62165b25acf64",
        "sha512": "4afd34b36b4d7c41260abad6d921154a3e7176a7a46de6ae97335697db5d11f61e37b08889c007463fc8f3e800788585f5f7d5b2cec12f89b69fc9bc15efd17f",
        "subdir": "grpc-1.70.2",
        "pragma": {"special": "ignore"}
      },
      "target_root": "targets",
      "bindings": {
        "rules": "rules",
        "protobuf": "protobuf",
        "ssl": "ssl",
        "absl": "absl",
        "zlib": "zlib",
        "re2": "re2",
        "cares": "cares"
      }
    }
  }
}
