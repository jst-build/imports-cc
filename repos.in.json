{
  "main": "libgit2",
  "imports": [
    {
      "source": "git",
      "branch": "system",
      "url": "https://github.com/jst-build/toolchains-cc.git",
      "repos": [{"alias": "toolchain"}]
    },
    {
      "source": "git",
      "branch": "zlib/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "zlib"}]
    },
    {
      "source": "git",
      "branch": "ssl/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "ssl"}]
    }
  ],
  "repositories": {
    "config": {"repository": {"type": "file", "path": "config"}},
    "targets": {"repository": {"type": "file", "path": "targets"}},
    "rules": {
      "repository": "toolchain",
      "target_root": "config",
      "rule_root": "toolchain",
      "bindings": {"base": "toolchain"}
    },
    "libgit2": {
      "repository": {
        "type": "archive",
        "content": "998cc0932494b23c242b86fda3635ef077c1ad81",
        "fetch": "https://github.com/libgit2/libgit2/archive/refs/tags/v1.9.7.tar.gz",
        "sha256": "1a4fbe7589e814777ae76b64734ad80f4ecad22cd33a22682a2aaea4ae5375e7",
        "sha512": "96924a4fd87669ad91d40669946cd249b646f3ce85380fc12b553b6c20338ff3c1df5faa6f168b2ca12ed20c8309116a05021f9710ee7ff61e5b8a249172b0ba",
        "subdir": "libgit2-1.9.7"
      },
      "target_root": "targets",
      "bindings": {"rules": "rules", "zlib": "zlib", "ssl": "ssl"}
    }
  }
}
