{
  "main": "curl",
  "imports": [
    {
      "source": "git",
      "branch": "system",
      "url": "https://github.com/jst-build/toolchains-cc.git",
      "repos": [{"alias": "toolchain"}]
    },
    {
      "source": "git",
      "branch": "zlib/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "zlib"}]
    },
    {
      "source": "git",
      "branch": "ssl/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "ssl"}]
    },
    {
      "source": "git",
      "branch": "cares/system",
      "url": "https://github.com/jst-build/imports-cc.git",
      "repos": [{"alias": "cares"}]
    }
  ],
  "repositories": {
    "config": {"repository": {"type": "file", "path": "config"}},
    "targets": {"repository": {"type": "file", "path": "targets"}},
    "rules": {
      "repository": "toolchain",
      "target_root": "config",
      "rule_root": "toolchain",
      "bindings": {"base": "toolchain"}
    },
    "curl": {
      "repository": {
        "type": "archive",
        "content": "7b7ace4d7cc7d4059163bbd789ef7071e5d326e5",
        "fetch": "https://github.com/curl/curl/releases/download/curl-8_6_0/curl-8.6.0.tar.gz",
        "sha256": "9c6db808160015f30f3c656c0dec125feb9dc00753596bf858a272b5dd8dc398",
        "sha512": "43fdb6b81b394f3382d353d5f57673b2b3d26cfe34b25d08a526bc0597f508d5298e5a7088d0736d1f139cad19cd922affa51533c3a5a4bb5f2de68891c2958d",
        "subdir": "curl-8.6.0"
      },
      "target_root": "targets",
      "bindings": {
        "rules": "rules",
        "zlib": "zlib",
        "ssl": "ssl",
        "cares": "cares"
      }
    }
  }
}
